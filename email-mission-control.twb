            <column caption='SAOs' datatype='real' name='[saos]' role='measure' type='quantitative' />
            <column-instance column='[Pipeline MQL-to-SAO]' derivation='User' name='[usr:Pipeline MQL-to-SAO:qk]' pivot='key' type='quantitative' />
