            <column caption='Program Type' datatype='string' name='[program_type]' role='dimension' type='nominal' />
            <column-instance column='[Pipeline Clicks SP]' derivation='User' name='[usr:Pipeline Clicks SP:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Pipeline Clicks Δ]' derivation='User' name='[usr:Pipeline Clicks Δ:qk]' pivot='key' type='quantitative' />
