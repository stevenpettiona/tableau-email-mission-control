    <worksheet name='[SC] Pipeline - Clicks'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#6b3fa0' fontname='Poppins' fontsize='8'>CLICKS</run>
