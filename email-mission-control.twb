          <range min='#2023-01-01#' />
        </column>
        <column alias='Period over Period' caption='Compare Period' datatype='string' name='[Compare Period]' param-domain-type='list' role='measure' type='nominal' value='&quot;PoP&quot;'>
          <calculation class='tableau' formula='&quot;PoP&quot;' />
          <aliases>
            <alias key='&quot;Custom&quot;' value='Custom Range' />
            <alias key='&quot;PoP&quot;' value='Period over Period' />
            <alias key='&quot;YoY&quot;' value='Year over Year' />
          </aliases>
        </column>
        <column caption='Comparison End' datatype='date' name='[Comparison End]' param-domain-type='range' role='measure' type='quantitative' value='#2025-05-01#'>
          <calculation class='tableau' formula='#2025-05-01#' />
          <range min='#2023-01-01#' />
        </column>
        <column caption='Comparison Start' datatype='date' name='[Comparison Start]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-01#'>
          <calculation class='tableau' formula='#2025-02-01#' />
          <range min='#2023-01-01#' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.ehemailengagement'>
        <column caption='CTOR SP' datatype='real' default-format='p0.00%' name='[CTOR SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Clicks SP] / IIF([Opens SP] = 0, NULL, [Opens SP])' />
        </column>
        <column caption='CTR SP' datatype='real' default-format='p0.00%' name='[CTR SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Clicks SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
        </column>
        <column caption='Clicks SP' datatype='integer' name='[Clicks SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Open Rate SP' datatype='real' default-format='p0.00%' name='[Open Rate SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Opens SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
        </column>
        <column caption='Opens SP' datatype='integer' name='[Opens SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Sends SP' datatype='integer' name='[Sends SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Send&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Sub-Campaign Display' datatype='string' name='[Sub Campaign Display]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [sub_campaign_name] = &quot;no associated sub-campaign&quot; THEN &quot;—&quot; ELSE [sub_campaign_name] END' />
        </column>
        <column caption='Unsub Rate SP' datatype='real' default-format='p0.00%' name='[Unsub Rate SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Unsubscribes SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
        </column>
        <column caption='Unsubscribes SP' datatype='integer' name='[Unsubscribes SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Comp Start Date' datatype='date' name='[Comp Start Date]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[Start Date], [Parameters].[End Date]) + 1), [Parameters].[Start Date]) ELSE [Parameters].[Comparison Start] END' />
        </column>
        <column caption='Comp End Date' datatype='date' name='[Comp End Date]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date]) ELSE [Parameters].[Comparison End] END' />
        </column>
        <column caption='Clicks LP' datatype='integer' name='[Clicks LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Opens LP' datatype='integer' name='[Opens LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Sends LP' datatype='integer' name='[Sends LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Send&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Unsubscribes LP' datatype='integer' name='[Unsubscribes LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='CTOR LP' datatype='real' default-format='p0.00%' name='[CTOR LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Clicks LP] / IIF([Opens LP] = 0, NULL, [Opens LP])' />
        </column>
        <column caption='CTR LP' datatype='real' default-format='p0.00%' name='[CTR LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Clicks LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
        </column>
        <column caption='Open Rate LP' datatype='real' default-format='p0.00%' name='[Open Rate LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Opens LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
        </column>
        <column caption='Unsub Rate LP' datatype='real' default-format='p0.00%' name='[Unsub Rate LP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Unsubscribes LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
        </column>
        <column caption='Clicks PoP %' datatype='real' default-format='p0.00%' name='[Clicks PoP %]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([Clicks SP] - [Clicks LP]) / IIF([Clicks LP] = 0, NULL, [Clicks LP])' />
        </column>
        <column caption='CTOR PoP %' datatype='real' default-format='p0.00%' name='[CTOR PoP %]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([CTOR SP] - [CTOR LP]) / IIF([CTOR LP] = 0, NULL, [CTOR LP])' />
        </column>
        <column caption='CTR PoP %' datatype='real' default-format='p0.00%' name='[CTR PoP %]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([CTR SP] - [CTR LP]) / IIF([CTR LP] = 0, NULL, [CTR LP])' />
        </column>
        <column caption='Open Rate PoP %' datatype='real' default-format='p0.00%' name='[Open Rate PoP %]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([Open Rate SP] - [Open Rate LP]) / IIF([Open Rate LP] = 0, NULL, [Open Rate LP])' />
        </column>
        <column caption='Opens PoP %' datatype='real' default-format='p0.00%' name='[Opens PoP %]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([Opens SP] - [Opens LP]) / IIF([Opens LP] = 0, NULL, [Opens LP])' />
        </column>
