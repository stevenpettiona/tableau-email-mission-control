              <range min='#2023-01-01#' />
            </column>
            <column caption='Lifecycle Stage Filter' datatype='string' name='[Lifecycle Stage Filter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Churn&quot;' value='Churn' />
                <alias key='&quot;Customer&quot;' value='Customer' />
                <alias key='&quot;Lead&quot;' value='Lead' />
                <alias key='&quot;Marketing Qualified Lead&quot;' value='Marketing Qualified Lead' />
                <alias key='&quot;Sales Accepted Lead&quot;' value='Sales Accepted Lead' />
                <alias key='&quot;Sales Qualified Lead&quot;' value='Sales Qualified Lead' />
                <alias key='&quot;Subscriber&quot;' value='Subscriber' />
              </aliases>
            </column>
            <column caption='Product' datatype='string' name='[Product Filter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;&quot;' value='Not Specified' />
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;CHR&quot;' value='CHR' />
                <alias key='&quot;EAP&quot;' value='EAP' />
