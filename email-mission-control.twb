            </map>
            <map to='#c8a6ef'>
              <bucket>&quot;micro&quot;</bucket>
            </map>
            <map to='#e3d3f7'>
              <bucket>&quot;mid-market&quot;</bucket>
            </map>
            <map to='#f1e9fb'>
              <bucket>&quot;Unknown&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:lifecycle_stage:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Lead&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Sales Qualified Lead&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Sales Accepted Lead&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Customer&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Opportunity&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;Subscriber&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Marketing Qualified Lead&quot;</bucket>
            </map>
            <map to='#ff9da7'>
              <bucket>&quot;Churn&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
