          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:Sends - SP - Platform:qk]&quot;' />
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:Open Rate - SP - Platform:qk]&quot;' />
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:CTR - SP - Platform:qk]&quot;' />
