            <column caption='Lifecycle Stage' datatype='string' name='[lifecycle_stage]' role='dimension' type='nominal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
            <column caption='Program Type' datatype='string' name='[program_type]' role='dimension' type='nominal' />
            <column-instance column='[CTR - SP - Platform]' derivation='User' name='[usr:CTR - SP - Platform:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Open Rate - SP - Platform]' derivation='User' name='[usr:Open Rate - SP - Platform:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sends - SP - Platform]' derivation='User' name='[usr:Sends - SP - Platform:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Unsub Rate - SP - Platform]' derivation='User' name='[usr:Unsub Rate - SP - Platform:qk]' pivot='key' type='quantitative' />
