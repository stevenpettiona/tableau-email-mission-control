            </column>
            <column caption='Program Type Quick Filter' datatype='string' name='[Program Type Quick Filter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Batch and Blast&quot;' value='Batch &amp; Blast' />
                <alias key='&quot;Default&quot;' value='Default' />
                <alias key='&quot;Email Nurture&quot;' value='Email Nurture' />
                <alias key='&quot;Event-Webinar&quot;' value='Event / Webinar' />
                <alias key='&quot;Newsletter&quot;' value='Newsletter' />
                <alias key='&quot;Sales Email&quot;' value='Sales Email' />
                <alias key='&quot;Training/Hero Academy&quot;' value='Training / Hero Academy' />
              </aliases>
            </column>
            <column caption='Start Date' datatype='date' name='[Start Date]' param-domain-type='range' role='measure' type='quantitative' value='#2026-02-01#'>
              <calculation class='tableau' formula='#2026-02-01#' />
              <range min='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.ehemailpipeline'>
            <column caption='Pipeline ARR per Won' datatype='real' default-format='&quot;$&quot;#,##0' name='[Pipeline ARR per Won]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Won ARR SP] / IIF([Wons SP] = 0, NULL, [Wons SP])' />
            </column>
            <column caption='Pipeline CTOR' datatype='real' default-format='p0.00%' name='[Pipeline CTOR]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Pipeline Clicks SP] / IIF([Pipeline Opens SP] = 0, NULL, [Pipeline Opens SP])' />
            </column>
            <column caption='Pipeline Click-to-MQL' datatype='real' default-format='p0.00%' name='[Pipeline Click-to-MQL]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Pipeline MQLs SP] / IIF([Pipeline Clicks SP] = 0, NULL, [Pipeline Clicks SP])' />
            </column>
            <column caption='Pipeline Clicks SP' datatype='integer' name='[Pipeline Clicks SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [clicks] END)' />
            </column>
            <column caption='Pipeline MQL-to-SAO' datatype='real' default-format='p0.00%' name='[Pipeline MQL-to-SAO]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SAOs SP] / IIF([Pipeline MQLs SP] = 0, NULL, [Pipeline MQLs SP])' />
            </column>
            <column caption='Pipeline MQLs SP' datatype='integer' name='[Pipeline MQLs SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(   IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [mqls] + [mqls_recycled]    END   )' />
            </column>
            <column caption='Pipeline Open Rate' datatype='real' default-format='p0.00%' name='[Pipeline Open Rate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Pipeline Opens SP] / IIF([Pipeline Sends SP] = 0, NULL, [Pipeline Sends SP])' />
            </column>
            <column caption='Pipeline Opens SP' datatype='integer' name='[Pipeline Opens SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [opens] END)' />
            </column>
            <column caption='Pipeline Sends SP' datatype='integer' name='[Pipeline Sends SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [sends] END)' />
            </column>
            <column caption='Pipeline Win Rate' datatype='real' default-format='p0.00%' name='[Pipeline Win Rate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Wons SP] / IIF([SAOs SP] = 0, NULL, [SAOs SP])' />
            </column>
            <column caption='SAOs SP' datatype='real' name='[SAOs SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [saos] END)' />
            </column>
            <column caption='Won ARR SP' datatype='real' default-format='&quot;$&quot;#,##0' name='[Won ARR SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [arr] END)' />
            </column>
            <column caption='Wons SP' datatype='real' name='[Wons SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [wons] END)' />
            </column>
            <column caption='Won ARR' datatype='real' default-format='&quot;$&quot;#,##0' name='[arr]' role='measure' type='quantitative' />
            <column caption='Program Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
