      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.ehemailpipeline].[usr:Pipeline Open Rate:qk]&quot;' value='Open Rate' />
          <alias key='&quot;[federated.ehemailpipeline].[usr:Pipeline Sends SP:qk]&quot;' value='Send' />
        </aliases>
      </column>
      <column caption='Pipeline - Dynamic SP' datatype='real' name='[Pipeline - Dynamic SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Pipeline Metric] WHEN &quot;MQL&quot; THEN [Pipeline MQLs SP] WHEN &quot;SAO&quot; THEN [SAOs SP] WHEN &quot;Won&quot; THEN [Wons SP] WHEN &quot;ARR&quot; THEN [Won ARR SP] END' />
      </column>
      <column caption='Pipeline ARR per Won' datatype='real' default-format='&quot;$&quot;#,##0' name='[Pipeline ARR per Won]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Won ARR SP] / IIF([Wons SP] = 0, NULL, [Wons SP])' />
      </column>
      <column caption='Pipeline CTOR' datatype='real' default-format='p0.00%' name='[Pipeline CTOR]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pipeline Clicks SP] / IIF([Pipeline Opens SP] = 0, NULL, [Pipeline Opens SP])' />
      </column>
      <column caption='Pipeline Click-to-MQL' datatype='real' default-format='p0.00%' name='[Pipeline Click-to-MQL]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pipeline MQLs SP] / IIF([Pipeline Clicks SP] = 0, NULL, [Pipeline Clicks SP])' />
      </column>
      <column caption='Pipeline Clicks LP' datatype='integer' default-format='#,##0' name='[Pipeline Clicks LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [clicks] END)' />
      </column>
      <column caption='Pipeline Clicks SP' datatype='integer' name='[Pipeline Clicks SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [clicks] END)' />
      </column>
      <column caption='Pipeline Clicks Δ' datatype='real' default-format='p0.00%' name='[Pipeline Clicks Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Pipeline Clicks SP] - [Pipeline Clicks LP]) / IIF([Pipeline Clicks LP] = 0, NULL, [Pipeline Clicks LP])' />
      </column>
      <column caption='Pipeline Comp End' datatype='datetime' name='[Pipeline Comp End]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date]) ELSE [Parameters].[Comparison End] END' />
      </column>
      <column caption='Pipeline Comp Start' datatype='datetime' name='[Pipeline Comp Start]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[Start Date], [Parameters].[End Date]) + 1), [Parameters].[Start Date]) ELSE [Parameters].[Comparison Start] END' />
      </column>
      <column caption='Pipeline MQL-to-SAO' datatype='real' default-format='p0.00%' name='[Pipeline MQL-to-SAO]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SAOs SP] / IIF([Pipeline MQLs SP] = 0, NULL, [Pipeline MQLs SP])' />
      </column>
      <column caption='Pipeline MQLs LP' datatype='integer' default-format='#,##0' name='[Pipeline MQLs LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(   IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [mqls] + [mqls_recycled]    END)' />
      </column>
      <column caption='Pipeline MQLs SP' datatype='integer' name='[Pipeline MQLs SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(   IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [mqls] + [mqls_recycled]    END)' />
      </column>
      <column caption='Pipeline MQLs Δ' datatype='real' default-format='p0.00%' name='[Pipeline MQLs Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Pipeline MQLs SP] - [Pipeline MQLs LP]) / IIF([Pipeline MQLs LP] = 0, NULL, [Pipeline MQLs LP])' />
      </column>
      <column caption='Pipeline Open Rate' datatype='real' default-format='p0.00%' name='[Pipeline Open Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pipeline Opens SP] / IIF([Pipeline Sends SP] = 0, NULL, [Pipeline Sends SP])' />
      </column>
      <column caption='Pipeline Opens LP' datatype='integer' default-format='#,##0' name='[Pipeline Opens LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [opens] END)' />
      </column>
      <column caption='Pipeline Opens SP' datatype='integer' name='[Pipeline Opens SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [opens] END)' />
      </column>
      <column caption='Pipeline Opens Δ' datatype='real' default-format='p0.00%' name='[Pipeline Opens Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Pipeline Opens SP] - [Pipeline Opens LP]) / IIF([Pipeline Opens LP] = 0, NULL, [Pipeline Opens LP])' />
      </column>
      <column caption='Pipeline Sends LP' datatype='integer' default-format='#,##0' name='[Pipeline Sends LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [sends] END)' />
      </column>
      <column caption='Pipeline Sends SP' datatype='integer' name='[Pipeline Sends SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [sends] END)' />
      </column>
      <column caption='Pipeline Sends Δ' datatype='real' default-format='p0.00%' name='[Pipeline Sends Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Pipeline Sends SP] - [Pipeline Sends LP]) / IIF([Pipeline Sends LP] = 0, NULL, [Pipeline Sends LP])' />
      </column>
      <column caption='Pipeline Unsubscribes LP' datatype='integer' name='[Pipeline Unsubscribes LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [unsubscribes] END)' />
      </column>
      <column caption='Pipeline Unsubscribes SP' datatype='integer' name='[Pipeline Unsubscribes SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [unsubscribes] END)' />
      </column>
      <column caption='Pipeline Unsubscribes Δ' datatype='real' default-format='p0.00%' name='[Pipeline Unsubscribes Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Pipeline Unsubscribes SP] - [Pipeline Unsubscribes LP]) / IIF([Pipeline Unsubscribes LP] = 0, NULL, [Pipeline Unsubscribes LP])' />
      </column>
      <column caption='Pipeline Win Rate' datatype='real' default-format='p0.00%' name='[Pipeline Win Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Wons SP] / IIF([SAOs SP] = 0, NULL, [SAOs SP])' />
      </column>
      <column caption='SAO ARR LY' datatype='real' default-format='&quot;$&quot;#,##0' name='[SAO ARR LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [arr] END)' />
      </column>
      <column caption='SAO ARR PoP %' datatype='real' default-format='p0.00%' name='[SAO ARR PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([SAO ARR SP] - [SAO ARR LY]) / IIF([SAO ARR LY] = 0, NULL, [SAO ARR LY])' />
      </column>
      <column caption='SAO ARR SP' datatype='real' default-format='&quot;$&quot;#,##0' name='[SAO ARR SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [arr] END)' />
      </column>
      <column caption='SAO ARR Δ' datatype='real' default-format='p0.00%' name='[SAO ARR Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([SAO ARR SP] - [SAO ARR LY]) / IIF([SAO ARR LY] = 0, NULL, [SAO ARR LY])' />
      </column>
      <column caption='SAO Rate (MQL→SAO)' datatype='real' default-format='p0.00%' name='[SAO Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([saos]) / IIF(SUM([mqls]) = 0, NULL, SUM([mqls]))' />
      </column>
      <column caption='SAOs LY' datatype='real' name='[SAOs LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [saos] END)' />
      </column>
      <column caption='SAOs PoP %' datatype='real' default-format='p0.00%' name='[SAOs PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([SAOs SP] - [SAOs LY]) / IIF([SAOs LY] = 0, NULL, [SAOs LY])' />
      </column>
      <column caption='SAOs SP' datatype='real' name='[SAOs SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [saos] END)' />
      </column>
      <column caption='SAOs Δ' datatype='real' default-format='p0.00%' name='[SAOs Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([SAOs SP] - [SAOs LY]) / IIF([SAOs LY] = 0, NULL, [SAOs LY])' />
      </column>
      <column caption='Won ARR LY' datatype='real' default-format='&quot;$&quot;#,##0' name='[Won ARR LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [arr] END)' />
      </column>
      <column caption='Won ARR PoP %' datatype='real' default-format='p0.00%' name='[Won ARR PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Won ARR SP] - [Won ARR LY]) / IIF([Won ARR LY] = 0, NULL, [Won ARR LY])' />
      </column>
      <column caption='Won ARR SP' datatype='real' default-format='&quot;$&quot;#,##0' name='[Won ARR SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [arr] END)' />
      </column>
      <column caption='Won ARR Δ' datatype='real' default-format='p0.00%' name='[Won ARR Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Won ARR SP] - [Won ARR LY]) / IIF([Won ARR LY] = 0, NULL, [Won ARR LY])' />
      </column>
      <column caption='Wons LY' datatype='real' name='[Wons LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [wons] END)' />
      </column>
      <column caption='Wons PoP %' datatype='real' default-format='p0.00%' name='[Wons PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Wons SP] - [Wons LY]) / IIF([Wons LY] = 0, NULL, [Wons LY])' />
      </column>
      <column caption='Wons SP' datatype='real' name='[Wons SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [wons] END)' />
      </column>
      <column caption='Wons Δ' datatype='real' default-format='p0.00%' name='[Wons Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Wons SP] - [Wons LY]) / IIF([Wons LY] = 0, NULL, [Wons LY])' />
      </column>
      <column caption='Won ARR' datatype='real' default-format='&quot;$&quot;#,##0' name='[arr]' role='measure' type='quantitative' />
      <column caption='Program Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
      <column caption='Campaign Source' datatype='string' name='[campaign_source]' role='dimension' type='nominal' />
      <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
      <column caption='Program Launch Month' datatype='date' name='[campaign_year_month]' role='dimension' type='ordinal' />
      <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
      <column caption='Clicks' datatype='integer' name='[clicks]' role='measure' type='quantitative' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' hidden='true' name='[dim_marketing_campaign_sk]' role='dimension' type='nominal' />
      <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
      <column caption='Industry' datatype='string' name='[industry]' role='dimension' type='nominal' />
      <column caption='MQLs' datatype='integer' name='[mqls]' role='measure' type='quantitative' />
      <column caption='MQLs (Recycled)' datatype='integer' name='[mqls_recycled]' role='measure' type='quantitative' />
      <column caption='Opens' datatype='integer' name='[opens]' role='measure' type='quantitative' />
      <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
      <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
      <column caption='Program Type' datatype='string' name='[program_type]' role='dimension' type='nominal' />
      <column caption='SAOs' datatype='real' name='[saos]' role='measure' type='quantitative' />
      <column caption='Sends' datatype='integer' name='[sends]' role='measure' type='quantitative' />
      <column caption='Sub-Campaign' datatype='string' name='[sub_campaign_name]' role='dimension' type='nominal' />
      <column caption='Unsubscribes' datatype='integer' name='[unsubscribes]' role='measure' type='quantitative' />
      <column caption='Wons' datatype='real' name='[wons]' role='measure' type='quantitative' />
      <column-instance column='[Pipeline Open Rate]' derivation='User' name='[usr:Pipeline Open Rate:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Pipeline Sends SP]' derivation='User' name='[usr:Pipeline Sends SP:qk]' pivot='key' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Australia&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
