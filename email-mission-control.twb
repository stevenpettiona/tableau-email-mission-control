              <calculation class='tableau' formula='([Open Rate SP] - [Open Rate LP]) / IIF([Open Rate LP] = 0, NULL, [Open Rate LP])' />
            </column>
            <column caption='Opens LP' datatype='integer' name='[Opens LP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
