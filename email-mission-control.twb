              <groupfilter function='member' level='[platform]' member='&quot;marketo&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.ehemailengagement].[:Measure Names]</column>
            <column>[federated.ehemailengagement].[platform]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
