              <bucket>&quot;[federated.ehemailengagement].[usr:CTR - SP - Platform:qk]&quot;</bucket>
              <bucket>&quot;[federated.ehemailengagement].[usr:Unsub Rate - SP - Platform:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.ehemailengagement].[platform]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[platform]' member='&quot;braze b2b&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.ehemailengagement].[:Measure Names]</column>
            <column>[federated.ehemailengagement].[platform]</column>
          </slices>
          <aggregation value='true' />
        </view>
