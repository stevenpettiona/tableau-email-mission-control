              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:Sends SP:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:Sends PoP \%:qk]&quot;' />
