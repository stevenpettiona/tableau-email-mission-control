            <column caption='Pipeline Comp End' datatype='datetime' name='[Pipeline Comp End]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date]) ELSE [Parameters].[Comparison End] END' />
            </column>
            <column caption='Pipeline Comp Start' datatype='datetime' name='[Pipeline Comp Start]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[Start Date], [Parameters].[End Date]) + 1), [Parameters].[Start Date]) ELSE [Parameters].[Comparison Start] END' />
            </column>
            <column caption='Pipeline Sends LP' datatype='integer' default-format='#,##0' name='[Pipeline Sends LP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Pipeline Comp Start] AND [event_timestamp] &lt;= [Pipeline Comp End] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [sends] END)' />
            </column>
            <column caption='Pipeline Sends SP' datatype='integer' name='[Pipeline Sends SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) THEN [sends] END)' />
