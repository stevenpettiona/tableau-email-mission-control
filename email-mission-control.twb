<datasource caption='EH Email Engagement' inline='true' name='federated.ehemailengagement' version='18.1'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='ehdw-01.c4377kymkso8.ap-southeast-2.redshift.amazonaws.com' name='redshift.ds1conn'>
        <connection authentication='auth-user-pass' class='redshift' dbname='dev' odbc-connect-string-extras='' one-time-sql='' port='5439' schema='mart' server='ehdw-01.c4377kymkso8.ap-southeast-2.redshift.amazonaws.com' show-other-databases='' single-node='' sslmode='require' username='tableau' />
      </named-connection>
    </named-connections>
    <relation connection='redshift.ds1conn' name='Email Engagement' type='text'>SELECT
    f.event_id,
    f.event_timestamp,
    DATE_TRUNC(&apos;week&apos;,  f.event_timestamp)::DATE AS event_week,
    DATE_TRUNC(&apos;month&apos;, f.event_timestamp)::DATE AS event_month,
    f.event_type,
    f.source                                      AS platform,
    f.dim_marketing_campaign_sk,
    c.campaign_name,
    c.sub_campaign_name,
    c.campaign_source,
    c.program_type,
    c.campaign_type,
    c.product,
    c.channel,
    c.direction,
    c.campaign_year_month,
    a.marketo_geo_code                            AS country,
    a.sf_estimated_company_size_category          AS company_size,
    a.marketo_industry                            AS industry,
    a.marketo_lifecycle_stage                     AS lifecycle_stage,
    a.marketo_mql_score                           AS mql_score
FROM mart.fct_marketing_email_engagement f
LEFT JOIN mart.dim_marketing_campaign c
    ON f.dim_marketing_campaign_sk = c.dim_marketing_campaign_sk
LEFT JOIN mart.dim_marketing_audience a
    ON f.dim_marketing_audience_sk = a.dim_marketing_audience_sk
    AND a.is_current = TRUE
WHERE f.event_type IN (&apos;Send&apos;,&apos;Open&apos;,&apos;Click&apos;,&apos;Unsubscribe&apos;)</relation>
    <cols>
      <map key='[event_id]' value='[Email Engagement].[event_id]' />
      <map key='[event_timestamp]' value='[Email Engagement].[event_timestamp]' />
      <map key='[event_week]' value='[Email Engagement].[event_week]' />
      <map key='[event_month]' value='[Email Engagement].[event_month]' />
      <map key='[event_type]' value='[Email Engagement].[event_type]' />
      <map key='[platform]' value='[Email Engagement].[platform]' />
      <map key='[dim_marketing_campaign_sk]' value='[Email Engagement].[dim_marketing_campaign_sk]' />
      <map key='[campaign_name]' value='[Email Engagement].[campaign_name]' />
      <map key='[sub_campaign_name]' value='[Email Engagement].[sub_campaign_name]' />
      <map key='[campaign_source]' value='[Email Engagement].[campaign_source]' />
      <map key='[program_type]' value='[Email Engagement].[program_type]' />
      <map key='[campaign_type]' value='[Email Engagement].[campaign_type]' />
      <map key='[product]' value='[Email Engagement].[product]' />
      <map key='[channel]' value='[Email Engagement].[channel]' />
      <map key='[direction]' value='[Email Engagement].[direction]' />
      <map key='[campaign_year_month]' value='[Email Engagement].[campaign_year_month]' />
      <map key='[country]' value='[Email Engagement].[country]' />
      <map key='[company_size]' value='[Email Engagement].[company_size]' />
      <map key='[industry]' value='[Email Engagement].[industry]' />
      <map key='[lifecycle_stage]' value='[Email Engagement].[lifecycle_stage]' />
      <map key='[mql_score]' value='[Email Engagement].[mql_score]' />
    </cols>
  </connection>
  <aliases enabled='yes' />
  <!-- Source columns -->
  <column datatype='string' hidden='true' name='[event_id]' role='dimension' type='nominal' />
  <column datatype='datetime' name='[event_timestamp]' role='dimension' type='ordinal' />
  <column caption='Event Week' datatype='date' name='[event_week]' role='dimension' type='ordinal' />
  <column caption='Event Month' datatype='date' name='[event_month]' role='dimension' type='ordinal' />
  <column caption='Event Type' datatype='string' name='[event_type]' role='dimension' type='nominal' />
  <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
  <column datatype='string' hidden='true' name='[dim_marketing_campaign_sk]' role='dimension' type='nominal' />
  <column caption='Program Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
  <column caption='Sub-Campaign' datatype='string' name='[sub_campaign_name]' role='dimension' type='nominal' />
  <column caption='Campaign Source' datatype='string' name='[campaign_source]' role='dimension' type='nominal' />
  <column caption='Program Type' datatype='string' name='[program_type]' role='dimension' type='nominal' />
  <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
  <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
  <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
  <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
  <column caption='Program Launch Month' datatype='date' name='[campaign_year_month]' role='dimension' type='ordinal' />
  <column caption='Country' datatype='string' name='[country]' role='dimension' type='nominal' />
  <column caption='Company Size' datatype='string' name='[company_size]' role='dimension' type='nominal' />
  <column caption='Industry' datatype='string' name='[industry]' role='dimension' type='nominal' />
  <column caption='Lifecycle Stage' datatype='string' name='[lifecycle_stage]' role='dimension' type='nominal' />
  <column caption='MQL Score' datatype='real' name='[mql_score]' role='measure' type='quantitative' />
  <column caption='Sends' datatype='integer' name='[Sends]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)' />
</column>
  <column caption='Opens' datatype='integer' name='[Opens]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Open&quot; THEN [event_id] END)' />
</column>
  <column caption='Clicks' datatype='integer' name='[Clicks]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Click&quot; THEN [event_id] END)' />
</column>
  <column caption='Unsubscribes' datatype='integer' name='[Unsubscribes]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Unsubscribe&quot; THEN [event_id] END)' />
</column>
  <column caption='Open Rate' datatype='real' default-format='0.0%' name='[Open Rate]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Open&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END))' />
</column>
  <column caption='CTR' datatype='real' default-format='0.0%' name='[CTR]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Click&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END))' />
</column>
  <column caption='CTOR' datatype='real' default-format='0.0%' name='[CTOR]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Click&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Open&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Open&quot; THEN [event_id] END))' />
</column>
  <column caption='Unsub Rate' datatype='real' default-format='0.0%' name='[Unsub Rate]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Unsubscribe&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END))' />
</column>
  <column caption='Unsub Rate Alert' datatype='boolean' name='[Unsub Rate Alert]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='COUNTD(IF [event_type]=&quot;Unsubscribe&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)) &gt; 0.005' />
</column>
  <column caption='Open Rate Traffic Light' datatype='string' name='[Traffic Light - Open Rate]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF COUNTD(IF [event_type]=&quot;Open&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)) &gt;= 0.25 THEN &quot;Green&quot; ELSEIF COUNTD(IF [event_type]=&quot;Open&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)) &gt;= 0.15 THEN &quot;Amber&quot; ELSE &quot;Red&quot; END' />
</column>
  <column caption='CTR Traffic Light' datatype='string' name='[Traffic Light - CTR]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF COUNTD(IF [event_type]=&quot;Click&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)) &gt;= 0.03 THEN &quot;Green&quot; ELSEIF COUNTD(IF [event_type]=&quot;Click&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)) &gt;= 0.01 THEN &quot;Amber&quot; ELSE &quot;Red&quot; END' />
</column>
  <column caption='Unsub Traffic Light' datatype='string' name='[Traffic Light - Unsub]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF COUNTD(IF [event_type]=&quot;Unsubscribe&quot; THEN [event_id] END) / IIF(COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END) = 0, NULL, COUNTD(IF [event_type]=&quot;Send&quot; THEN [event_id] END)) &gt; 0.005 THEN &quot;Red&quot; ELSE &quot;Green&quot; END' />
</column>
  <column caption='Program Type Badge' datatype='string' name='[Program Type Badge]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='CASE [program_type] WHEN &quot;Batch and Blast&quot; THEN &quot;BB&quot; WHEN &quot;Email Nurture&quot; THEN &quot;EN&quot; WHEN &quot;Sales Email&quot; THEN &quot;SE&quot; WHEN &quot;Newsletter&quot; THEN &quot;NL&quot; WHEN &quot;Event-Webinar&quot; THEN &quot;EV&quot; WHEN &quot;Training/Hero Academy&quot; THEN &quot;TR&quot; ELSE &quot;DE&quot; END' />
</column>
  <column caption='Sub-Campaign Display' datatype='string' name='[Sub Campaign Display]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [sub_campaign_name] = &quot;no associated sub-campaign&quot; THEN &quot;&#8212;&quot; ELSE [sub_campaign_name] END' />
</column>
  <column caption='Comp Start Date' datatype='date' name='[Comp Start Date]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[Start Date], [Parameters].[End Date]) + 1), [Parameters].[Start Date]) ELSE [Parameters].[Comparison Start] END' />
</column>
  <column caption='Comp End Date' datatype='date' name='[Comp End Date]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date]) ELSE [Parameters].[Comparison End] END' />
</column>
  <column caption='Sends SP' datatype='integer' name='[Sends SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Send&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Opens SP' datatype='integer' name='[Opens SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Clicks SP' datatype='integer' name='[Clicks SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Unsubscribes SP' datatype='integer' name='[Unsubscribes SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Sends LP' datatype='integer' name='[Sends LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Send&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Opens LP' datatype='integer' name='[Opens LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Clicks LP' datatype='integer' name='[Clicks LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Unsubscribes LP' datatype='integer' name='[Unsubscribes LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_id] END)' />
</column>
  <column caption='Open Rate SP' datatype='real' default-format='0.0%' name='[Open Rate SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Opens SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
</column>
  <column caption='CTR SP' datatype='real' default-format='0.0%' name='[CTR SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Clicks SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
</column>
  <column caption='CTOR SP' datatype='real' default-format='0.0%' name='[CTOR SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Clicks SP] / IIF([Opens SP] = 0, NULL, [Opens SP])' />
</column>
  <column caption='Unsub Rate SP' datatype='real' default-format='0.0%' name='[Unsub Rate SP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Unsubscribes SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
</column>
  <column caption='Open Rate LP' datatype='real' default-format='0.0%' name='[Open Rate LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Opens LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
</column>
  <column caption='CTR LP' datatype='real' default-format='0.0%' name='[CTR LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Clicks LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
</column>
  <column caption='CTOR LP' datatype='real' default-format='0.0%' name='[CTOR LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Clicks LP] / IIF([Opens LP] = 0, NULL, [Opens LP])' />
</column>
  <column caption='Unsub Rate LP' datatype='real' default-format='0.0%' name='[Unsub Rate LP]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Unsubscribes LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
</column>
  <column caption='Sends Δ' datatype='real' default-format='p0.00%' name='[Sends Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Sends SP] - [Sends LP]) / IIF([Sends LP] = 0, NULL, [Sends LP])' />
</column>
  <column caption='Opens Δ' datatype='real' default-format='p0.00%' name='[Opens Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Opens SP] - [Opens LP]) / IIF([Opens LP] = 0, NULL, [Opens LP])' />
</column>
  <column caption='Clicks Δ' datatype='real' default-format='p0.00%' name='[Clicks Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Clicks SP] - [Clicks LP]) / IIF([Clicks LP] = 0, NULL, [Clicks LP])' />
</column>
  <column caption='Unsubscribes Δ' datatype='real' default-format='p0.00%' name='[Unsubscribes Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Unsubscribes SP] - [Unsubscribes LP]) / IIF([Unsubscribes LP] = 0, NULL, [Unsubscribes LP])' />
</column>
  <column caption='Open Rate Δ' datatype='real' default-format='p0.00%' name='[Open Rate Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Open Rate SP] - [Open Rate LP]) / IIF([Open Rate LP] = 0, NULL, [Open Rate LP])' />
</column>
  <column caption='CTR Δ' datatype='real' default-format='p0.00%' name='[CTR Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([CTR SP] - [CTR LP]) / IIF([CTR LP] = 0, NULL, [CTR LP])' />
</column>
  <column caption='CTOR Δ' datatype='real' default-format='p0.00%' name='[CTOR Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([CTOR SP] - [CTOR LP]) / IIF([CTOR LP] = 0, NULL, [CTOR LP])' />
</column>
  <column caption='Unsub Rate Δ' datatype='real' default-format='p0.00%' name='[Unsub Rate Δ]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Unsub Rate SP] - [Unsub Rate LP]) / IIF([Unsub Rate LP] = 0, NULL, [Unsub Rate LP])' />
</column>
</datasource>

<datasource caption='EH Email Pipeline' inline='true' name='federated.ehemailpipeline' version='18.1'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='ehdw-01.c4377kymkso8.ap-southeast-2.redshift.amazonaws.com' name='redshift.ds2conn'>
        <connection authentication='auth-user-pass' class='redshift' dbname='dev' odbc-connect-string-extras='' one-time-sql='' port='5439' schema='mart' server='ehdw-01.c4377kymkso8.ap-southeast-2.redshift.amazonaws.com' show-other-databases='' single-node='' sslmode='require' username='tableau' />
      </named-connection>
    </named-connections>
    <relation type='collection'>
      <relation connection='redshift.ds2conn' name='Email Events' type='text'>SELECT
    f.event_id,
    f.event_timestamp,
    DATE_TRUNC(&apos;week&apos;,  f.event_timestamp)::DATE AS event_week,
    DATE_TRUNC(&apos;month&apos;, f.event_timestamp)::DATE AS event_month,
    f.event_type,
    f.source                                      AS platform,
    f.dim_marketing_campaign_sk,
    c.campaign_name,
    c.sub_campaign_name,
    c.campaign_source,
    c.program_type,
    c.campaign_type,
    c.product,
    c.channel,
    c.direction,
    c.campaign_year_month,
    a.marketo_geo_code                            AS country,
    a.sf_estimated_company_size_category          AS company_size,
    a.marketo_industry                            AS industry,
    a.marketo_lifecycle_stage                     AS lifecycle_stage,
    a.marketo_mql_score                           AS mql_score
FROM mart.fct_marketing_email_engagement f
LEFT JOIN mart.dim_marketing_campaign c
    ON f.dim_marketing_campaign_sk = c.dim_marketing_campaign_sk
LEFT JOIN mart.dim_marketing_audience a
    ON f.dim_marketing_audience_sk = a.dim_marketing_audience_sk
    AND a.is_current = TRUE
WHERE f.event_type IN (&apos;Send&apos;,&apos;Open&apos;,&apos;Click&apos;,&apos;Unsubscribe&apos;)</relation>
      <relation connection='redshift.ds2conn' name='Program MQLs' type='text'>SELECT
    dim_marketing_campaign_sk,
    date              AS mql_date,
    country           AS mql_country,
    employee_segment  AS mql_segment,
    SUM(mql_count)    AS mqls,
    SUM(lead_count)   AS leads,
    SUM(recycled_mql_count) AS recycled_mqls
FROM mart.rpt_marketing_mofu_leads
WHERE dim_marketing_campaign_sk IS NOT NULL
GROUP BY 1, 2, 3, 4</relation>
      <relation connection='redshift.ds2conn' name='Program SAOs' type='text'>SELECT
    dim_marketing_campaign_sk,
    date              AS sao_date,
    country           AS sao_country,
    employee_segment  AS sao_segment,
    SUM(sao_count)    AS saos,
    SUM(sao_arr)      AS sao_arr_aud
FROM mart.rpt_marketing_bofu_opportunities
WHERE dim_marketing_campaign_sk IS NOT NULL
GROUP BY 1, 2, 3, 4</relation>
    </relation>
    <object-graph>
      <objects>
        <object caption='Email Events' id='Email Events_DS2_ROOT'>
          <properties context=''>
            <relation connection='redshift.ds2conn' name='Email Events' type='text' />
          </properties>
        </object>
        <object caption='Program MQLs' id='Program MQLs_DS2'>
          <properties context=''>
            <relation connection='redshift.ds2conn' name='Program MQLs' type='text' />
          </properties>
        </object>
        <object caption='Program SAOs' id='Program SAOs_DS2'>
          <properties context=''>
            <relation connection='redshift.ds2conn' name='Program SAOs' type='text' />
          </properties>
        </object>
      </objects>
      <relationships>
        <relationship cardinality-1='many' cardinality-2='many' integrity-1='some' integrity-2='some'>
          <expression op='='>
            <expression op='[dim_marketing_campaign_sk]' />
            <expression op='[dim_marketing_campaign_sk (Email Events)]' />
          </expression>
          <first-end-point object-id='Program MQLs_DS2' />
          <second-end-point object-id='Email Events_DS2_ROOT' />
        </relationship>
        <relationship cardinality-1='many' cardinality-2='many' integrity-1='some' integrity-2='some'>
          <expression op='='>
            <expression op='[dim_marketing_campaign_sk]' />
            <expression op='[dim_marketing_campaign_sk (Email Events)]' />
          </expression>
          <first-end-point object-id='Program SAOs_DS2' />
          <second-end-point object-id='Email Events_DS2_ROOT' />
        </relationship>
      </relationships>
    </object-graph>
    <cols>
      <map key='[event_id]' value='[Email Events].[event_id]' />
      <map key='[event_timestamp]' value='[Email Events].[event_timestamp]' />
      <map key='[event_week]' value='[Email Events].[event_week]' />
      <map key='[event_month]' value='[Email Events].[event_month]' />
      <map key='[event_type]' value='[Email Events].[event_type]' />
      <map key='[platform]' value='[Email Events].[platform]' />
      <map key='[dim_marketing_campaign_sk (Email Events)]' value='[Email Events].[dim_marketing_campaign_sk]' />
