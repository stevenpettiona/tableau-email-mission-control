    <worksheet name='[BC] Platform Scorecard Braze B2B'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Poppins' fontsize='10'>Braze B2B</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='EH Email Engagement' name='federated.ehemailengagement' />
