            <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
            <column caption='Program Type' datatype='string' name='[program_type]' role='dimension' type='nominal' />
            <column-instance column='[Unsubscribes SP]' derivation='User' name='[usr:Unsubscribes SP:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Unsubscribes Δ]' derivation='User' name='[usr:Unsubscribes Δ:qk]' pivot='key' type='quantitative' />
