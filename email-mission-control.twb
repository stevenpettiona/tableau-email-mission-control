  <column caption='MQL Country' datatype='string' name='[mql_country]' role='dimension' type='nominal' />
  <column caption='MQL Segment' datatype='string' name='[mql_segment]' role='dimension' type='nominal' />
  <column caption='MQLs' datatype='integer' name='[mqls]' role='measure' type='quantitative' />
  <column caption='Leads' datatype='integer' name='[leads]' role='measure' type='quantitative' />
  <column caption='Recycled MQLs' datatype='integer' name='[recycled_mqls]' role='measure' type='quantitative' />
  <!-- Program SAOs columns -->
  <column caption='SAO Date' datatype='date' name='[sao_date]' role='dimension' type='ordinal' />
  <column caption='SAO Country' datatype='string' name='[sao_country]' role='dimension' type='nominal' />
  <column caption='SAO Segment' datatype='string' name='[sao_segment]' role='dimension' type='nominal' />
  <column caption='SAOs' datatype='integer' name='[saos]' role='measure' type='quantitative' />
  <column caption='SAO ARR (AUD)' datatype='real' default-format='&quot;$&quot;#,##0' name='[sao_arr_aud]' role='measure' type='quantitative' />
  <column caption='SAO Rate (MQL&#8594;SAO)' datatype='real' default-format='0.0%' name='[SAO Rate]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([saos]) / IIF(SUM([mqls]) = 0, NULL, SUM([mqls]))' />
</column>
