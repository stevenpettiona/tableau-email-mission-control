          <range min='#2023-01-01#' />
        </column>
        <column caption='Platform' datatype='string' name='[Platform Filter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;All&quot;' value='All' />
            <alias key='&quot;braze b2b&quot;' value='Braze B2B' />
            <alias key='&quot;marketo&quot;' value='Marketo' />
          </aliases>
        </column>
        <column caption='Product' datatype='string' name='[Product Filter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;&quot;' value='Not Specified' />
            <alias key='&quot;All&quot;' value='All' />
            <alias key='&quot;CHR&quot;' value='CHR' />
            <alias key='&quot;EAP&quot;' value='EAP' />
            <alias key='&quot;GC&quot;' value='GC' />
            <alias key='&quot;HRA&quot;' value='HRA' />
            <alias key='&quot;LMS&quot;' value='LMS' />
            <alias key='&quot;MP&quot;' value='MP' />
          </aliases>
        </column>
        <column caption='Program Type' datatype='string' name='[Program Type Filter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;All&quot;' value='All' />
            <alias key='&quot;Batch and Blast&quot;' value='Batch &amp; Blast' />
            <alias key='&quot;Default&quot;' value='Default' />
            <alias key='&quot;Email Nurture&quot;' value='Email Nurture' />
            <alias key='&quot;Event-Webinar&quot;' value='Event / Webinar' />
            <alias key='&quot;Newsletter&quot;' value='Newsletter' />
            <alias key='&quot;Sales Email&quot;' value='Sales Email' />
            <alias key='&quot;Training/Hero Academy&quot;' value='Training / Hero Academy' />
          </aliases>
        </column>
        <column caption='Start Date' datatype='date' name='[Start Date]' param-domain-type='range' role='measure' type='quantitative' value='#2026-02-01#'>
          <calculation class='tableau' formula='#2026-02-01#' />
          <range min='#2023-01-01#' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.ehemailengagement'>
        <column caption='Clicks SP' datatype='integer' name='[Clicks SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='Opens SP' datatype='integer' name='[Opens SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) THEN [event_count] END)' />
        </column>
        <column caption='CTOR SP' datatype='real' default-format='p0.00%' name='[CTOR SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[Clicks SP] / IIF([Opens SP] = 0, NULL, [Opens SP])' />
        </column>
        <column caption='Company Size' datatype='string' name='[company_size]' role='dimension' type='nominal' />
        <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
