      <aliases enabled='yes' />
      <column caption='MQLs SP (p)' datatype='integer' name='[Calculation_4499886727589889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[mqls]' />
      </column>
      <column caption='SAO ARR LY' datatype='integer' default-format='&quot;$&quot;#,##0' name='[SAO ARR LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) AND [sao_date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) THEN [sao_arr_weighted_cust] END)' />
      </column>
      <column caption='SAO ARR PoP %' datatype='real' default-format='p0.00%' name='[SAO ARR PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([SAO ARR SP] - [SAO ARR LY]) / IIF([SAO ARR LY] = 0, NULL, [SAO ARR LY])' />
      </column>
      <column caption='SAO ARR SP' datatype='integer' default-format='&quot;$&quot;#,##0' name='[SAO ARR SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= [Parameters].[Start Date] AND [sao_date] &lt;= [Parameters].[End Date] THEN [sao_arr_weighted_cust] END)' />
      </column>
      <column caption='SAO Rate (MQL→SAO)' datatype='real' default-format='p0.00%' name='[SAO Rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([saos]) / IIF(SUM([mqls]) = 0, NULL, SUM([mqls]))' />
      </column>
      <column caption='SAOs LY' datatype='integer' name='[SAOs LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) AND [sao_date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) THEN [saos_weighted_cust] END)' />
      </column>
      <column caption='SAOs PoP %' datatype='real' default-format='p0.00%' name='[SAOs PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([SAOs SP] - [SAOs LY]) / IIF([SAOs LY] = 0, NULL, [SAOs LY])' />
      </column>
      <column caption='SAOs SP' datatype='integer' name='[SAOs SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= [Parameters].[Start Date] AND [sao_date] &lt;= [Parameters].[End Date] THEN [saos_weighted_cust] END)' />
      </column>
      <column caption='Won ARR LY' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Won ARR LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) AND [sao_date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) THEN [won_arr_weighted_cust] END)' />
      </column>
      <column caption='Won ARR PoP %' datatype='real' default-format='p0.00%' name='[Won ARR PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Won ARR SP] - [Won ARR LY]) / IIF([Won ARR LY] = 0, NULL, [Won ARR LY])' />
      </column>
      <column caption='Won ARR SP' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Won ARR SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= [Parameters].[Start Date] AND [sao_date] &lt;= [Parameters].[End Date] THEN [won_arr_weighted_cust] END)' />
      </column>
      <column caption='Wons LY' datatype='integer' name='[Wons LY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) AND [sao_date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) THEN [wons_weighted_cust] END)' />
      </column>
      <column caption='Wons PoP %' datatype='real' default-format='p0.00%' name='[Wons PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Wons SP] - [Wons LY]) / IIF([Wons LY] = 0, NULL, [Wons LY])' />
      </column>
      <column caption='Wons SP' datatype='integer' name='[Wons SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= [Parameters].[Start Date] AND [sao_date] &lt;= [Parameters].[End Date] THEN [wons_weighted_cust] END)' />
