      <column caption='CTOR LP' datatype='real' default-format='p0.00%' name='[CTOR LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Clicks LP] / IIF([Opens LP] = 0, NULL, [Opens LP])' />
      </column>
      <column caption='CTOR PoP %' datatype='real' default-format='p0.00%' name='[CTOR PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CTOR SP] - [CTOR LP]) / IIF([CTOR LP] = 0, NULL, [CTOR LP])' />
      </column>
      <column caption='CTOR SP' datatype='real' default-format='p0.00%' name='[CTOR SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Clicks SP] / IIF([Opens SP] = 0, NULL, [Opens SP])' />
      </column>
      <column caption='CTOR Δ' datatype='real' default-format='p0.00%' name='[CTOR Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CTOR SP] - [CTOR LP]) / IIF([CTOR LP] = 0, NULL, [CTOR LP])' />
      </column>
      <column caption='CTOR' datatype='real' default-format='p0.00%' name='[CTOR]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_type]=&quot;Click&quot; THEN [event_count] END) / IIF(SUM(IF [event_type]=&quot;Open&quot; THEN [event_count] END) = 0, NULL, SUM(IF [event_type]=&quot;Open&quot; THEN [event_count] END))' />
      </column>
      <column caption='CTR - SP - Platform' datatype='real' default-format='p0.00%' name='[CTR - SP - Platform]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Clicks - SP - Platform] / IIF([Sends - SP - Platform] = 0, NULL, [Sends - SP - Platform])' />
      </column>
      <column caption='CTR LP' datatype='real' default-format='p0.00%' name='[CTR LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Clicks LP] / IIF([Sends LP] = 0, NULL, [Sends LP])' />
      </column>
      <column caption='CTR PoP %' datatype='real' default-format='p0.00%' name='[CTR PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CTR SP] - [CTR LP]) / IIF([CTR LP] = 0, NULL, [CTR LP])' />
      </column>
      <column caption='CTR SP' datatype='real' default-format='p0.00%' name='[CTR SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Clicks SP] / IIF([Sends SP] = 0, NULL, [Sends SP])' />
      </column>
      <column caption='CTR Δ' datatype='real' default-format='p0.00%' name='[CTR Δ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CTR SP] - [CTR LP]) / IIF([CTR LP] = 0, NULL, [CTR LP])' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.00%' name='[CTR]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_type]=&quot;Click&quot; THEN [event_count] END) / IIF(SUM(IF [event_type]=&quot;Send&quot; THEN [event_count] END) = 0, NULL, SUM(IF [event_type]=&quot;Send&quot; THEN [event_count] END))' />
      </column>
      <column caption='Dynamic SP' datatype='real' default-format='p0.00%' name='[Calculation_2626799926677504]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='CASE [Parameters].[Direction (copy)] &#10;WHEN &apos;Open Rate&apos; THEN [Open Rate SP]&#10;WHEN &apos;CTR&apos; THEN [CTR SP]&#10;WHEN &apos;CTOR&apos; THEN [CTOR SP]&#10;WHEN &apos;Unsubscribe Rate&apos; THEN [Unsub Rate SP]&#10;END' />
      </column>
      <column caption='Clicks - SP - Platform' datatype='integer' name='[Clicks - SP - Platform]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
      </column>
      <column caption='Clicks LP' datatype='integer' name='[Clicks LP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
      </column>
      <column caption='Clicks PoP %' datatype='real' default-format='p0.00%' name='[Clicks PoP %]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Clicks SP] - [Clicks LP]) / IIF([Clicks LP] = 0, NULL, [Clicks LP])' />
      </column>
      <column caption='Clicks SP' datatype='integer' name='[Clicks SP]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
