              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:CTOR SP:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:CTOR PoP \%:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailengagement].[usr:Open Rate SP:qk]&quot;' />
