          <datasource-dependencies datasource='federated.ehemailengagement'>
            <column caption='Comp End Date' datatype='datetime' name='[Comp End Date]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[End Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date]) ELSE [Parameters].[Comparison End] END' />
            </column>
            <column caption='Comp Start Date' datatype='datetime' name='[Comp Start Date]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Compare Period] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[Start Date]) ELSEIF [Parameters].[Compare Period] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[Start Date], [Parameters].[End Date]) + 1), [Parameters].[Start Date]) ELSE [Parameters].[Comparison Start] END' />
            </column>
            <column caption='Unsubscribes LP' datatype='integer' name='[Unsubscribes LP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Comp Start Date] AND [event_timestamp] &lt;= [Comp End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
            </column>
            <column caption='Unsubscribes SP' datatype='integer' name='[Unsubscribes SP]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Platform Filter] = &quot;All&quot; OR [platform] = [Parameters].[Platform Filter]) AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
            </column>
            <column caption='Unsubscribes Δ' datatype='real' default-format='p0.00%' name='[Unsubscribes Δ]' role='measure' type='quantitative'>
