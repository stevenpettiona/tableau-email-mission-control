            </column>
            <column caption='Pipeline Opens Δ' datatype='real' default-format='p0.00%' name='[Pipeline Opens Δ]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Pipeline Opens SP] - [Pipeline Opens LP]) / IIF([Pipeline Opens LP] = 0, NULL, [Pipeline Opens LP])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[event_timestamp]' role='dimension' type='ordinal' />
            <column caption='Opens' datatype='integer' name='[opens]' role='measure' type='quantitative' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Program Type' datatype='string' name='[program_type]' role='dimension' type='nominal' />
            <column-instance column='[Pipeline Opens SP]' derivation='User' name='[usr:Pipeline Opens SP:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Pipeline Opens Δ]' derivation='User' name='[usr:Pipeline Opens Δ:qk]' pivot='key' type='quantitative' />
