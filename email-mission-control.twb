      <style>
        <style-rule element='dashboard'>
          <format attr='background-color' value='#f5f3fa' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-weight' value='bold' />
          <format attr='color' value='#4b2b72' />
          <format attr='font-size' value='6' />
