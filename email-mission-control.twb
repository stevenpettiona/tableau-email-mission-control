                <alias key='&quot;Sales Email&quot;' value='Sales Email' />
                <alias key='&quot;Training/Hero Academy&quot;' value='Training / Hero Academy' />
              </aliases>
            </column>
            <column caption='Start Date' datatype='date' name='[Start Date]' param-domain-type='range' role='measure' type='quantitative' value='#2026-02-01#'>
              <calculation class='tableau' formula='#2026-02-01#' />
              <range min='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.ehemailengagement'>
            <column caption='CTR - SP - Platform' datatype='real' default-format='p0.00%' name='[CTR - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Clicks - SP - Platform] / IIF([Sends - SP - Platform] = 0, NULL, [Sends - SP - Platform])' />
            </column>
            <column caption='Clicks - SP - Platform' datatype='integer' name='[Clicks - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Click&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
            </column>
            <column caption='Open Rate - SP - Platform' datatype='real' default-format='p0.00%' name='[Open Rate - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Opens - SP - Platform] / IIF([Sends - SP - Platform] = 0, NULL, [Sends - SP - Platform])' />
            </column>
            <column caption='Opens - SP - Platform' datatype='integer' name='[Opens - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Open&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
            </column>
            <column caption='Sends - SP - Platform' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Sends - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Send&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
            </column>
            <column caption='Unsub Rate - SP - Platform' datatype='real' default-format='p0.00%' name='[Unsub Rate - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unsubscribes - SP - Platform] / IIF([Sends - SP - Platform] = 0, NULL, [Sends - SP - Platform])' />
            </column>
            <column caption='Unsubscribes - SP - Platform' datatype='integer' name='[Unsubscribes - SP - Platform]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event_type] = &quot;Unsubscribe&quot; AND [event_timestamp] &gt;= [Parameters].[Start Date] AND [event_timestamp] &lt;= [Parameters].[End Date] AND ([Parameters].[Program Type Quick Filter] = &quot;All&quot; OR [program_type] = [Parameters].[Program Type Quick Filter]) AND ([Parameters].[Direction Filter] = &quot;All&quot; OR [direction] = [Parameters].[Direction Filter]) AND ([Parameters].[Country Filter] = &quot;All&quot; OR [country] = [Parameters].[Country Filter]) AND ([Parameters].[Company Size Filter] = &quot;All&quot; OR [company_size] = [Parameters].[Company Size Filter]) AND ([Parameters].[Product Filter] = &quot;All&quot; OR [product] = [Parameters].[Product Filter] OR ([Parameters].[Product Filter] = &quot;&quot; AND ISNULL([product]))) AND ([Parameters].[Lifecycle Stage Filter] = &quot;All&quot; OR [lifecycle_stage] = [Parameters].[Lifecycle Stage Filter]) THEN [event_count] END)' />
            </column>
            <column caption='Company Size' datatype='string' name='[company_size]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
