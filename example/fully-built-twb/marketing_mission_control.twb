              <calculation class='tableau' formula='(SUM([cf_impressions_sp_full]) - SUM([cf_impressions_sply])) / ZN(SUM([cf_impressions_sply]))' />
            </column>
            <column caption='Impressions - YoY % - No Region' datatype='real' default-format='p0.00%' name='[cf_impressions_yoy_noregion]' role='measure' type='quantitative'>
