            <column caption='Won Arr Weighted With Unattributed Ft' datatype='real' name='[won_arr_weighted_with_unattributed_ft]' role='measure' type='quantitative' />
            <column caption='Won Arr Weighted With Unattributed Lc' datatype='real' name='[won_arr_weighted_with_unattributed_lc]' role='measure' type='quantitative' />
            <column caption='Won Arr Weighted With Unattributed Us' datatype='real' name='[won_arr_weighted_with_unattributed_us]' role='measure' type='quantitative' />
            <column caption='Won Arr Weighted With Unattributed Ws' datatype='real' name='[won_arr_weighted_with_unattributed_ws]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0h0rhj21s8fugq1ekg8b50nmig8c].[Action (Alpha Two Letter)]'>
            <groupfilter function='member' level='[alpha_two_letter]' member='&quot;AU&quot;' user:ui-action-filter='[Action1_AEA470A18D6C41478B4523E9CBCE6CA6]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
