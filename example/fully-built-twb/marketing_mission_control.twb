            <column caption='Sao Weighted With Unattributed Cust' datatype='real' name='[sao_weighted_with_unattributed_cust]' role='measure' type='quantitative' />
            <column caption='Sao Weighted With Unattributed Ft' datatype='real' name='[sao_weighted_with_unattributed_ft]' role='measure' type='quantitative' />
