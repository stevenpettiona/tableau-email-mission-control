            <column caption='Won ARR - SP - Compare' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[Won ARR - SP (copy)_5530743643701248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10; IF [Parameters].[Attribution Model (copy)_5530743644000257] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[Attribution Model (copy)_5530743644000257] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[Attribution Model (copy)_5530743644000257] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[Attribution Model (copy)_5530743644000257] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[Attribution Model (copy)_5530743644000257] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Attribution Winner' datatype='string' name='[cf_attr_sensitivity_winner]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM([Won ARR - SP (copy)_5530743643701248])-SUM([cf_won_arr_sp]))/SUM([cf_won_arr_sp])) &gt; 0 &#10;THEN [Parameters].[Attribution Model (copy)_5530743644000257] &#10;ELSE [Parameters].[param_attributionmodel] &#10;END' />
            </column>
            <column caption='CC2 - Row Dimension' datatype='string' name='[cf_cc2_row_dim]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[param_cc2_breakout]' />
            </column>
            <column caption='Won ARR - SP' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_won_arr_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Country (Rpt Marketing Bofu Opportunities)' datatype='string' name='[country (rpt_marketing_bofu_opportunities)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
