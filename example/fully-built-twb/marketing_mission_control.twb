            </column>
            <column caption='Won - SPLY' datatype='real' name='[cf_won_sply]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won - YoY %' datatype='real' default-format='p0.00%' name='[cf_won_yoy]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([SAO - SP (copy)_1469696710713355]) - SUM([cf_won_sply])) / ZN(SUM([cf_won_sply]))' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Country (Rpt Marketing Bofu Opportunities)' datatype='string' name='[country (rpt_marketing_bofu_opportunities)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
            <column caption='Employee Segment (Rpt Marketing Bofu Opportunities)' datatype='string' name='[employee_segment (rpt_marketing_bofu_opportunities)]' role='dimension' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Requested Demo (Rpt Marketing Bofu Opportunities)' datatype='string' datatype-customized='true' name='[requested_demo (rpt_marketing_bofu_opportunities)]' role='dimension' type='nominal' />
            <column caption='Sao Weighted With Unattributed Cust' datatype='real' name='[sao_weighted_with_unattributed_cust]' role='measure' type='quantitative' />
            <column caption='Sao Weighted With Unattributed Ft' datatype='real' name='[sao_weighted_with_unattributed_ft]' role='measure' type='quantitative' />
            <column caption='Sao Weighted With Unattributed Lc' datatype='real' name='[sao_weighted_with_unattributed_lc]' role='measure' type='quantitative' />
