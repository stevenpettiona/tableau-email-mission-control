              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [spend] END' />
            </column>
            <column caption='Spend - SP - No Region' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_spend_sp_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [spend] END' />
            </column>
            <column caption='Spend - SPLY' datatype='real' name='[cf_spend_sply]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;THEN [spend] END' />
            </column>
            <column caption='Spend - SPLY - No Region' datatype='real' name='[cf_spend_sply_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;THEN [spend] END' />
            </column>
            <column caption='Spend - YoY %' datatype='real' default-format='p0.00%' name='[cf_spend_yoy]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_spend_sp]) - SUM([cf_spend_sply])) / ZN(SUM([cf_spend_sply]))' />
            </column>
            <column caption='Spend - YoY % - No Region' datatype='real' default-format='p0.00%' name='[cf_spend_yoy_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_spend_sp_noregion]) - SUM([cf_spend_sply_noregion])) / ZN(SUM([cf_spend_sply_noregion]))' />
            </column>
            <column caption='TA3 - Cost per MQL Target ($150)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[cf_ta3_cpmql_target]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='150' />
            </column>
            <column caption='TA3 - CVR SAO to Won' datatype='real' default-format='p0.00%' name='[cf_ta3_cvr_sao_to_won]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([SAO - SP (copy)_1469696710713355]) / ZN(SUM([Calculation_1469696709189642]))' />
            </column>
            <column caption='TA3 - Trend Metric Value (SP)' datatype='real' name='[cf_ta3_metric_value]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_ta3_metric_selector] = &quot;MQLs&quot; THEN SUM([cf_mql_sp])&#10;ELSEIF [Parameters].[param_ta3_metric_selector] = &quot;SAOs&quot; THEN SUM([Calculation_1469696709189642])&#10;ELSEIF [Parameters].[param_ta3_metric_selector] = &quot;Form Fills&quot; THEN SUM([cf_formfills_sp])&#10;ELSEIF [Parameters].[param_ta3_metric_selector] = &quot;Won&quot; THEN SUM([SAO - SP (copy)_1469696710713355])&#10;END' />
            </column>
            <column caption='TA3 - Trend Metric Value (SPLY)' datatype='real' name='[cf_ta3_metric_value_sply]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_ta3_metric_selector] = &quot;MQLs&quot; THEN SUM([cf_mql_sply])&#10;ELSEIF [Parameters].[param_ta3_metric_selector] = &quot;SAOs&quot; THEN SUM([cf_sao_sply])&#10;ELSEIF [Parameters].[param_ta3_metric_selector] = &quot;Form Fills&quot; THEN SUM([cf_formfills_sply_full])&#10;ELSEIF [Parameters].[param_ta3_metric_selector] = &quot;Won&quot; THEN SUM([cf_won_sply])&#10;END' />
            </column>
