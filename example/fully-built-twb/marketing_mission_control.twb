            <column caption='Cost per SAO - YoY %' datatype='real' default-format='p0.00%' name='[Cost per SAO - MoM % (copy)_0821193529798659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([cf_cost_per_sao_sp] - [Cost per SAO - SP (copy)_0821193529618434]) / ZN([Cost per SAO - SP (copy)_0821193529618434])' />
