            </column>
            <column caption='ATTR5 - Metric - W-Shaped SP' datatype='real' name='[cf_attr5_metric_ws_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10;  IF [Parameters].[param_attr5_metric] = &quot;SAOs&quot; THEN [sao_weighted_with_unattributed_ws]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;Won&quot; THEN [won_weighted_with_unattributed_ws]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;ARR&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - Custom Model SP' datatype='real' name='[cf_attr5_sao_cust_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_cust]&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - First Touch SP' datatype='real' name='[cf_attr5_sao_ft_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_ft]&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - Lead Creation SP' datatype='real' name='[cf_attr5_sao_lc_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_lc]&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - U-Shaped SP' datatype='real' name='[cf_attr5_sao_us_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_us]&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - W-Shaped SP' datatype='real' name='[cf_attr5_sao_ws_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_ws]&#10;END' />
            </column>
            <column caption='ATTR5 - Touch Count SP' datatype='integer' name='[cf_attr5_touch_count_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN 1&#10;END' />
            </column>
            <column caption='Avg ARR per Won - SP' datatype='real' default-format='&quot;$&quot;#,##0' name='[cf_avg_arr_per_won]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_won_arr_sp]) / ZN(SUM([SAO - SP (copy)_1469696710713355]))' />
            </column>
            <column caption='Comparison Period - End Date' datatype='datetime' name='[cf_comparison_enddate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_enddate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_enddate]&#10;END' />
            </column>
            <column caption='Comparison Period - Start Date' datatype='datetime' name='[cf_comparison_startdate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[param_startdate], [Parameters].[param_enddate]) + 1), [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_startdate]&#10;END' />
            </column>
            <column caption='Cost per FF - SP' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_ff_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_sp]) / ZN(SUM([cf_formfills_sp]))' />
            </column>
            <column caption='Cost per MQL - MoM %' datatype='real' default-format='p0.00%' name='[cf_cost_per_mql_mom]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1469696697065472] - [cf_cost_per_mql_pm]) / ZN([cf_cost_per_mql_pm])' />
            </column>
            <column caption='Cost per MQL - PM' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_mql_pm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_pm]) / ZN(SUM([cf_mql_pm]))' />
            </column>
            <column caption='Cost per MQL vs Target ($149)' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_mql_vs_target]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1469696697065472] - 149' />
            </column>
            <column caption='Cost per SAO - MoM %' datatype='real' default-format='p0.00%' name='[cf_cost_per_sao_mom]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([cf_cost_per_sao_sp] - [cf_cost_per_sao_pm]) / ZN([cf_cost_per_sao_pm])' />
            </column>
            <column caption='Cost per SAO - PM' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_sao_pm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_pm]) / ZN(SUM([cf_sao_pm]))' />
            </column>
            <column caption='Cost per SAO - SP' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_sao_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_sp]) / ZN(SUM([cf_sao_sp]))' />
            </column>
            <column caption='Cost per Won - MoM %' datatype='real' default-format='p0.00%' name='[cf_cost_per_won_mom]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([cf_cost_per_won_sp] - [cf_cost_per_won_pm]) / ZN([cf_cost_per_won_pm])' />
            </column>
            <column caption='Cost per Won - PM' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_won_pm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_pm]) / ZN(SUM([cf_won_pm]))' />
            </column>
            <column caption='Cost per Won - SP' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_won_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_sp]) / ZN(SUM([SAO - SP (copy)_1469696710713355]))' />
            </column>
            <column caption='Formfills - Current Month' datatype='integer' name='[cf_formfills_cm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [relative_month] = 0&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [formfills] END' />
            </column>
            <column caption='Formfills - MoM %' datatype='real' default-format='p0.00%' name='[cf_formfills_mom]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_formfills_cm]) - SUM([cf_formfills_pm])) / ZN(SUM([cf_formfills_pm]))' />
            </column>
            <column caption='Formfills - No Date' datatype='integer' name='[cf_formfills_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [Parameters].[param_channel] = [channel_group])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [Parameters].[param_direction] = [direction])&#10;THEN [formfills] END' />
            </column>
            <column caption='Formfills - Prior Month' datatype='integer' name='[cf_formfills_pm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [relative_month] = -1&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [formfills] END' />
            </column>
