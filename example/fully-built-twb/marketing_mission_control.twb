            <column caption='Sao Weighted With Unattributed Ws' datatype='real' name='[sao_weighted_with_unattributed_ws]' role='measure' type='quantitative' />
            <column caption='Spend' datatype='real' name='[spend]' role='measure' type='quantitative' />
            <column-instance column='[Cost per MQL - SP (copy)_1469696707379208]' derivation='User' name='[usr:Cost per MQL - SP (copy)_1469696707379208:qk]' pivot='key' type='quantitative' />
            <column-instance column='[SAO per Won - SP (copy)_1469696711561231]' derivation='User' name='[usr:SAO per Won - SP (copy)_1469696711561231:qk]' pivot='key' type='quantitative' />
            <column caption='Won Weighted With Unattributed Cust' datatype='real' name='[won_weighted_with_unattributed_cust]' role='measure' type='quantitative' />
            <column caption='Won Weighted With Unattributed Ft' datatype='real' name='[won_weighted_with_unattributed_ft]' role='measure' type='quantitative' />
            <column caption='Won Weighted With Unattributed Lc' datatype='real' name='[won_weighted_with_unattributed_lc]' role='measure' type='quantitative' />
            <column caption='Won Weighted With Unattributed Us' datatype='real' name='[won_weighted_with_unattributed_us]' role='measure' type='quantitative' />
