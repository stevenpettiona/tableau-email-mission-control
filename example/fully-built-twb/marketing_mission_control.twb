            <datasource caption='Marketing Mission Control Dataset' name='federated.0h0rhj21s8fugq1ekg8b50nmig8c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Channel' datatype='string' name='[param_channel]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='All' caption='Direction' datatype='string' name='[param_direction]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Inbound&quot;' value='Inbound' />
                <alias key='&quot;Outbound&quot;' value='Outbound' />
                <alias key='&quot;Partner&quot;' value='Partner' />
              </aliases>
            </column>
            <column caption='End Date' datatype='date' name='[param_enddate]' param-domain-type='range' role='measure' type='quantitative' value='#2026-03-31#'>
              <calculation class='tableau' formula='#2026-03-31#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='MQL Sub-type' datatype='string' name='[param_mqltsubype]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='No Demo' />
                <alias key='&quot;1&quot;' value='Demo' />
              </aliases>
            </column>
            <column alias='CA' caption='Region' datatype='string' name='[param_region]' param-domain-type='list' role='measure' type='nominal' value='&quot;Canada&quot;'>
              <calculation class='tableau' formula='&quot;Canada&quot;' />
              <aliases>
                <alias key='&quot;Australia&quot;' value='AU' />
                <alias key='&quot;Canada&quot;' value='CA' />
                <alias key='&quot;Malaysia&quot;' value='MY' />
                <alias key='&quot;New Zealand&quot;' value='NZ' />
                <alias key='&quot;Singapore&quot;' value='SG' />
                <alias key='&quot;United Kingdom&quot;' value='UK' />
              </aliases>
            </column>
            <column alias='All' caption='Segment' datatype='string' name='[param_segment]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;core&quot;' value='Core' />
                <alias key='&quot;micro&quot;' value='Micro' />
                <alias key='&quot;mid-market&quot;' value='Mid Market' />
              </aliases>
            </column>
            <column caption='Start Date' datatype='date' name='[param_startdate]' param-domain-type='range' role='measure' type='quantitative' value='#2026-03-01#'>
              <calculation class='tableau' formula='#2026-03-01#' />
              <range min='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='Custom Model % by Channel' datatype='real' default-format='p0.00%' name='[cf_attr5_cust_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_attr5_sao_cust_sp]) &#10;/ &#10;sum({ FIXED [Parameters].[param_startdate], [Parameters].[param_enddate], [Parameters].[param_region], [Parameters].[param_segment], [Parameters].[param_direction] , [Parameters].[param_mqltsubype] : SUM([cf_attr5_sao_cust_sp]) })' />
            </column>
            <column caption=' First Touch % by Channel' datatype='real' default-format='p0.00%' name='[cf_attr5_ft_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_attr5_sao_ft_sp]) / &#10;sum({ FIXED [Parameters].[param_startdate], [Parameters].[param_enddate], [Parameters].[param_region], [Parameters].[param_segment], [Parameters].[param_direction] , [Parameters].[param_mqltsubype] : SUM([cf_attr5_sao_ft_sp]) })' />
            </column>
            <column caption='Custome Model Influence Gap %' datatype='real' default-format='p0.00%' name='[cf_attr5_influence_gap]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cf_attr5_cust_pct] - MIN([cf_attr5_ft_pct],[cf_attr5_lc_pct])' />
            </column>
            <column caption='Lead Creation % by Channel' datatype='real' default-format='p0.00%' name='[cf_attr5_lc_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_attr5_sao_lc_sp]) / &#10;sum({ FIXED [Parameters].[param_startdate], [Parameters].[param_enddate], [Parameters].[param_region], [Parameters].[param_segment], [Parameters].[param_direction] , [Parameters].[param_mqltsubype] : SUM([cf_attr5_sao_lc_sp]) })' />
            </column>
            <column caption='ATTR5 - SAO - Custom Model SP' datatype='real' name='[cf_attr5_sao_cust_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_cust]&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - First Touch SP' datatype='real' name='[cf_attr5_sao_ft_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_ft]&#10;END' />
            </column>
            <column caption='ATTR5 - SAO - Lead Creation SP' datatype='real' name='[cf_attr5_sao_lc_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sao_weighted_with_unattributed_lc]&#10;END' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Channel Group Broad' datatype='string' name='[channel_group_broad]' role='dimension' type='nominal' />
            <column caption='Country (Rpt Marketing Bofu Opportunities)' datatype='string' name='[country (rpt_marketing_bofu_opportunities)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
