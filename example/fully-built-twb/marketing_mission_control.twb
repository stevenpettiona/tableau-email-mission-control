              <groupfilter function='member' level='[none:employee_segment (Custom SQL Query):nk]' member='&quot;core&quot;' />
              <groupfilter function='member' level='[none:employee_segment (Custom SQL Query):nk]' member='&quot;unknown&quot;' />
