<worksheet name='[BC] ROI4 - Spend vs Pipeline'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#4b2b72' fontname='Tableau Block' fontsize='8'>SPEND VS PIPELINE — BY PERIOD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Marketing Mission Control Dataset' name='federated.0h0rhj21s8fugq1ekg8b50nmig8c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Channel' datatype='string' name='[param_channel]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='All' caption='Direction' datatype='string' name='[param_direction]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Inbound&quot;' value='Inbound' />
                <alias key='&quot;Outbound&quot;' value='Outbound' />
                <alias key='&quot;Partner&quot;' value='Partner' />
              </aliases>
            </column>
            <column caption='End Date' datatype='date' name='[param_enddate]' param-domain-type='range' role='measure' type='quantitative' value='#2026-03-31#'>
              <calculation class='tableau' formula='#2026-03-31#' />
              <range min='#2023-01-01#' />
            </column>
            <column alias='All' caption='MQL Type' datatype='string' name='[param_mqltype]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;New&quot;' value='New' />
                <alias key='&quot;Recycled&quot;' value='Recycled' />
              </aliases>
            </column>
            <column alias='CA' caption='Region' datatype='string' name='[param_region]' param-domain-type='list' role='measure' type='nominal' value='&quot;Canada&quot;'>
              <calculation class='tableau' formula='&quot;Canada&quot;' />
              <aliases>
                <alias key='&quot;Australia&quot;' value='AU' />
                <alias key='&quot;Canada&quot;' value='CA' />
                <alias key='&quot;Malaysia&quot;' value='MY' />
                <alias key='&quot;New Zealand&quot;' value='NZ' />
                <alias key='&quot;Singapore&quot;' value='SG' />
                <alias key='&quot;United Kingdom&quot;' value='UK' />
              </aliases>
            </column>
            <column alias='Week' caption='Granularity' datatype='string' name='[param_roi4_granularity]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column alias='Yes' caption='Show MQLs' datatype='string' name='[param_roi4_show_mqls]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
              <aliases>
                <alias key='&quot;No&quot;' value='No' />
                <alias key='&quot;Yes&quot;' value='Yes' />
              </aliases>
            </column>
            <column alias='Yes' caption='Show SAOs' datatype='string' name='[param_roi4_show_saos]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
              <aliases>
                <alias key='&quot;No&quot;' value='No' />
                <alias key='&quot;Yes&quot;' value='Yes' />
              </aliases>
            </column>
            <column alias='All' caption='Segment' datatype='string' name='[param_segment]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;core&quot;' value='Core' />
                <alias key='&quot;micro&quot;' value='Micro' />
                <alias key='&quot;mid-market&quot;' value='Mid Market' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='ROI4 - Chart Date Filter' datatype='string' name='[ROI4 - Chart Date (copy)_3302308846485507]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (([Parameters].[param_roi4_granularity] = &quot;day&quot; AND DATEDIFF(&apos;day&apos;, DATEADD(&apos;day&apos;, -14, [Parameters].[param_enddate]), [report_date]) &gt;= 0)&#10;OR ([Parameters].[param_roi4_granularity] = &quot;week&quot; AND DATEDIFF(&apos;week&apos;, DATEADD(&apos;week&apos;, -12, [Parameters].[param_enddate]), [report_date]) &gt;= 0)&#10;OR ([Parameters].[param_roi4_granularity] = &quot;month&quot; AND DATEDIFF(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[param_enddate]), [report_date]) &gt;= 0))&#10;AND [report_date] &lt;= [Parameters].[param_enddate]&#10;THEN &quot;true&quot; ELSE &quot;false&quot; END' />
            </column>
            <column caption='ROI4 - Chart Date Label' datatype='string' name='[ROI4 - Chart Date (copy)_3302308891381765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[param_roi4_granularity]&#10;   WHEN &apos;month&apos; THEN STR(YEAR([report_date]))+&quot;/&quot;+STR(MONTH([report_date]))&#10;   WHEN &apos;week&apos; THEN STR(YEAR([report_date]))+&quot; WK&quot;+LEFT(DATENAME(&apos;week&apos;, [report_date]), 2)&#10;   WHEN &apos;day&apos; THEN STR(YEAR([report_date]))+&quot;/&quot;+STR(MONTH([report_date]))+&quot;/&quot;+STR(DAY([report_date]))&#10;END' />
            </column>
            <column caption='ROI4 - Spend Line' datatype='real' default-format='C3081%' name='[ROI4 - SAOs Line (Toggle) (copy)_3302308842614784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [spend] END' />
            </column>
            <column caption='ROI4 - MQLs Line (Toggle)' datatype='integer' name='[cf_roi4_mqls_line]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_roi4_show_mqls] = &quot;Yes&quot;&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_mofu_leads)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_mofu_leads)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN&#10;    IF ([Parameters].[param_mqltype] = &quot;All&quot;) THEN [mql_count] + [recycled_mql_count]&#10;        ELSEIF ([Parameters].[param_mqltype] = &quot;New&quot;) THEN [mql_count]&#10;        ELSEIF ([Parameters].[param_mqltype] = &quot;Recycled&quot;) THEN [recycled_mql_count] &#10;    END&#10;END' />
            </column>
            <column caption='ROI4 - SAOs Line (Toggle)' datatype='integer' name='[cf_roi4_saos_line]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_roi4_show_saos] = &quot;Yes&quot; &#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [sao_count] END' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Country (Rpt Marketing Bofu Opportunities)' datatype='string' name='[country (rpt_marketing_bofu_opportunities)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country (Rpt Marketing Mofu Leads)' datatype='string' name='[country (rpt_marketing_mofu_leads)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
            <column caption='Employee Segment (Rpt Marketing Bofu Opportunities)' datatype='string' name='[employee_segment (rpt_marketing_bofu_opportunities)]' role='dimension' type='nominal' />
            <column caption='Employee Segment (Rpt Marketing Mofu Leads)' datatype='string' name='[employee_segment (rpt_marketing_mofu_leads)]' role='dimension' type='nominal' />
