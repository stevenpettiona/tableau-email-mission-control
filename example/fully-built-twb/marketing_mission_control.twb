            <column caption='Won Arr Weighted With Unattributed Us' datatype='real' name='[won_arr_weighted_with_unattributed_us]' role='measure' type='quantitative' />
            <column caption='Won Arr Weighted With Unattributed Ws' datatype='real' name='[won_arr_weighted_with_unattributed_ws]' role='measure' type='quantitative' />
