            </column>
            <column caption='MQL - SPLY - No Region - No Segment' datatype='integer' name='[cf_mql_sply_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;THEN &#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='MQL to SAO CVR' datatype='real' default-format='p0.00%' name='[cf_mql_to_sao_cvr]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1469696709189642]) / ZN(SUM([cf_mql_sp]))' />
            </column>
            <column caption='MQL to SAO CVR - SP - No Region' datatype='real' default-format='p0.00%' name='[cf_mql_to_sao_cvr_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_sao_sp_noregion]) / ZN(SUM([cf_mql_sp_noregion]))' />
            </column>
            <column caption='MQL - YoY %' datatype='real' default-format='p0.00%' name='[cf_mql_yoy]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([cf_mql_sp]) - sum([cf_mql_sply])) / ZN(sum([cf_mql_sply]))' />
            </column>
            <column caption='MQL - YoY % - No Region' datatype='real' default-format='p0.00%' name='[cf_mql_yoy_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([cf_mql_sp_noregion] - [MQL - SP - No Region (copy)_0334934234742785])/ZN([MQL - SP - No Region (copy)_0334934234742785])' />
            </column>
            <column caption='MQL - YoY % - No Region - No Segment' datatype='real' default-format='p0.00%' name='[cf_mql_yoy_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_mql_sp_noregion]) - SUM([cf_mql_sply_noseg_noregion])) / ZN(SUM([cf_mql_sply_noseg_noregion]))' />
            </column>
            <column caption='ROI4 - Cost per MQL (Channel)' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_roi4_cost_per_mql_channel]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_roi4_spend_by_channel]) / ZN(SUM([cf_mql_sp]))' />
            </column>
            <column caption='ROI4 - MQLs Line (Toggle)' datatype='integer' name='[cf_roi4_mqls_line]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_roi4_show_mqls] = &quot;Yes&quot;&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_mofu_leads)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_mofu_leads)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN&#10;    IF ([Parameters].[param_mqltype] = &quot;All&quot;) THEN [mql_count] + [recycled_mql_count]&#10;        ELSEIF ([Parameters].[param_mqltype] = &quot;New&quot;) THEN [mql_count]&#10;        ELSEIF ([Parameters].[param_mqltype] = &quot;Recycled&quot;) THEN [recycled_mql_count] &#10;    END&#10;END' />
            </column>
            <column caption='ROI4 - MQLs (Chart Raw)' datatype='integer' name='[cf_roi4_mqls_raw]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_mofu_leads)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_mofu_leads)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='ROI4 - SAOs Line (Toggle)' datatype='integer' name='[cf_roi4_saos_line]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_roi4_show_saos] = &quot;Yes&quot; &#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [sao_count] END' />
