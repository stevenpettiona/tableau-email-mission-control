              <range min='#2023-01-01#' />
            </column>
            <column caption='MQL Sub-type' datatype='string' name='[param_mqltsubype]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='No Demo' />
                <alias key='&quot;1&quot;' value='Demo' />
              </aliases>
            </column>
            <column alias='Period over Period' caption='Period Comparison' datatype='string' name='[param_periodcomparison]' param-domain-type='list' role='measure' type='nominal' value='&quot;PoP&quot;'>
              <calculation class='tableau' formula='&quot;PoP&quot;' />
              <aliases>
                <alias key='&quot;Custom&quot;' value='Custom Range' />
                <alias key='&quot;PoP&quot;' value='Period over Period' />
                <alias key='&quot;YoY&quot;' value='Year over Year' />
              </aliases>
            </column>
            <column caption='Comparison End Date' datatype='date' name='[param_periodcomparison_enddate]' param-domain-type='range' role='measure' type='quantitative' value='#2025-04-29#'>
              <calculation class='tableau' formula='#2025-04-29#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='Comparison Start Date' datatype='date' name='[param_periodcomparison_startdate]' param-domain-type='range' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
              <range min='#2023-01-01#' />
            </column>
