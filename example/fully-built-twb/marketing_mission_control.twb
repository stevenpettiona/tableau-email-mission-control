                <zone forceUpdate='true' h='2300' id='1236' type-v2='text' w='19001' x='80071' y='17000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#3e1962' fontname='Tableau Light' fontsize='8'>Full Path / Custom</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
