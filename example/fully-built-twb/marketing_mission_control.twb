              <calculation class='tableau' formula='#2026-03-01#' />
              <range min='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='Comparison Period - End Date' datatype='datetime' name='[cf_comparison_enddate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_enddate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_enddate]&#10;END' />
            </column>
            <column caption='Comparison Period - Start Date' datatype='datetime' name='[cf_comparison_startdate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[param_startdate], [Parameters].[param_enddate]) + 1), [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_startdate]&#10;END' />
            </column>
            <column caption='Formfills - SP' datatype='integer' name='[cf_formfills_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [Parameters].[param_channel] = [channel_group])&#10;AND ([Parameters].[param_direction] = &quot;All&quot;  OR [Parameters].[param_direction] = [direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [formfills] END' />
            </column>
            <column caption='Formfills - SPLY' datatype='integer' name='[cf_formfills_sply]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot;)&#10;AND ([Parameters].[param_direction] = &quot;All&quot;)&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;THEN [formfills] END' />
            </column>
            <column caption='Formfills - YoY %' datatype='real' default-format='p0.00%' name='[cf_formfills_yoy]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_formfills_sp]) - SUM([cf_formfills_sply])) / ZN(SUM([cf_formfills_sply]))' />
            </column>
            <column caption='Sessions - SP' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[cf_sessions_sp_full]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sessions] END' />
            </column>
            <column caption='Sessions to Formfills CVR' datatype='real' default-format='p0.00%' name='[cf_sessions_to_ff_cvr]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_formfills_sp]) / ZN(SUM([cf_sessions_sp_full]))' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
            <column caption='Employee Segment' datatype='string' name='[employee_segment]' role='dimension' type='nominal' />
            <column caption='Formfills' datatype='integer' name='[formfills]' role='measure' type='quantitative' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Sessions' datatype='integer' name='[sessions]' role='measure' type='quantitative' />
            <column-instance column='[cf_formfills_yoy]' derivation='User' name='[usr:cf_formfills_yoy:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cf_sessions_to_ff_cvr]' derivation='User' name='[usr:cf_sessions_to_ff_cvr:qk]' pivot='key' type='quantitative' />
