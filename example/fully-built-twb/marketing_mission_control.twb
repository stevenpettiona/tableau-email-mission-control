<worksheet name='[TBL] CC2 - Full Funnel by Campaign Name'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Marketing Mission Control Dataset' name='federated.0h0rhj21s8fugq1ekg8b50nmig8c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Custom Model' caption='Attribution Model' datatype='string' name='[param_attributionmodel]' param-domain-type='list' role='measure' type='nominal' value='&quot;Custom Model&quot;'>
              <calculation class='tableau' formula='&quot;Custom Model&quot;' />
              <aliases>
                <alias key='&quot;Custom Model&quot;' value='Custom Model' />
                <alias key='&quot;First Touch&quot;' value='First Touch' />
                <alias key='&quot;Lead Creation&quot;' value='Lead Creation' />
                <alias key='&quot;U-Shaped&quot;' value='U-Shaped' />
                <alias key='&quot;W-Shaped&quot;' value='W-Shaped' />
              </aliases>
            </column>
            <column caption='CC2 Breakout' datatype='string' name='[param_cc2_breakout]' param-domain-type='list' role='measure' type='nominal' value='&quot;Channel&quot;'>
              <calculation class='tableau' formula='&quot;Channel&quot;' />
            </column>
            <column caption='Channel' datatype='string' name='[param_channel]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='All' caption='Direction' datatype='string' name='[param_direction]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Inbound&quot;' value='Inbound' />
                <alias key='&quot;Outbound&quot;' value='Outbound' />
                <alias key='&quot;Partner&quot;' value='Partner' />
              </aliases>
            </column>
            <column caption='End Date' datatype='date' name='[param_enddate]' param-domain-type='range' role='measure' type='quantitative' value='#2026-03-31#'>
              <calculation class='tableau' formula='#2026-03-31#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='MQL Sub-type' datatype='string' name='[param_mqltsubype]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='No Demo' />
                <alias key='&quot;1&quot;' value='Demo' />
              </aliases>
            </column>
            <column alias='All' caption='MQL Type' datatype='string' name='[param_mqltype]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;New&quot;' value='New' />
                <alias key='&quot;Recycled&quot;' value='Recycled' />
              </aliases>
            </column>
            <column alias='CA' caption='Region' datatype='string' name='[param_region]' param-domain-type='list' role='measure' type='nominal' value='&quot;Canada&quot;'>
              <calculation class='tableau' formula='&quot;Canada&quot;' />
              <aliases>
                <alias key='&quot;Australia&quot;' value='AU' />
                <alias key='&quot;Canada&quot;' value='CA' />
                <alias key='&quot;Malaysia&quot;' value='MY' />
                <alias key='&quot;New Zealand&quot;' value='NZ' />
                <alias key='&quot;Singapore&quot;' value='SG' />
                <alias key='&quot;United Kingdom&quot;' value='UK' />
              </aliases>
            </column>
            <column alias='All' caption='Segment' datatype='string' name='[param_segment]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;core&quot;' value='Core' />
                <alias key='&quot;micro&quot;' value='Micro' />
                <alias key='&quot;mid-market&quot;' value='Mid Market' />
              </aliases>
            </column>
            <column caption='Start Date' datatype='date' name='[param_startdate]' param-domain-type='range' role='measure' type='quantitative' value='#2026-03-01#'>
              <calculation class='tableau' formula='#2026-03-01#' />
              <range min='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='SAO - SP' datatype='real' name='[Calculation_1469696709189642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN &#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [sao_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [sao_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [sao_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [sao_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [sao_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='SAO per Won - SP' datatype='real' default-format='p0.00%' name='[Calculation_1469696711094284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([SAO - SP (copy)_1469696710713355])/ZN(Sum([Calculation_1469696709189642]))' />
            </column>
            <column caption='Won - SP' datatype='real' name='[SAO - SP (copy)_1469696710713355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN &#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Show Campaign' datatype='string' name='[Show Channel (copy)_3780598231511043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[param_cc2_breakout] = &apos;Campaign&apos; then [campaign_name (dim_marketing_campaign)] END' />
            </column>
            <column caption='Campaign Name (Dim Marketing Campaign)' datatype='string' name='[campaign_name (dim_marketing_campaign)]' role='dimension' type='nominal' />
            <column caption='CC2 - Row Dimension' datatype='string' name='[cf_cc2_row_dim]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[param_cc2_breakout]' />
            </column>
            <column caption='Formfills - SP' datatype='integer' name='[cf_formfills_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [Parameters].[param_channel] = [channel_group])&#10;AND ([Parameters].[param_direction] = &quot;All&quot;  OR [Parameters].[param_direction] = [direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [formfills] END' />
            </column>
            <column caption='Impressions - SP' datatype='integer' name='[cf_impressions_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;All&quot; OR [country] = [Parameters].[param_region])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [impressions] END' />
            </column>
            <column caption='MQL - per Formfills' datatype='real' default-format='p0.00%' name='[cf_mql_per_formfills]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([cf_mql_sp])/ZN(sum([cf_formfills_sp]))' />
            </column>
            <column caption='MQL - SP' datatype='integer' name='[cf_mql_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_mofu_leads)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_mofu_leads)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo] = [Parameters].[param_mqltsubype])&#10;THEN &#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='MQL to SAO CVR' datatype='real' default-format='p0.00%' name='[cf_mql_to_sao_cvr]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1469696709189642]) / ZN(SUM([cf_mql_sp]))' />
            </column>
            <column caption='Sessions - SP' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[cf_sessions_sp_full]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [sessions] END' />
            </column>
            <column caption='Sessions to Formfills CVR' datatype='real' default-format='p0.00%' name='[cf_sessions_to_ff_cvr]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_formfills_sp]) / ZN(SUM([cf_sessions_sp_full]))' />
            </column>
            <column caption='Spend - Current Month' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_spend_cm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [relative_month] = 0&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [spend] END' />
            </column>
            <column caption='Spend - MoM %' datatype='real' default-format='p0.00%' name='[cf_spend_mom]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_spend_cm]) - SUM([cf_spend_pm])) / ZN(SUM([cf_spend_pm]))' />
            </column>
            <column caption='Spend - Prior Month' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_spend_pm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [relative_month] = -1&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [spend] END' />
            </column>
            <column caption='Spend - SP' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_spend_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [spend] END' />
            </column>
            <column caption='Won ARR - Current Month' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_won_arr_cm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [relative_month] = 0&#10;AND ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
