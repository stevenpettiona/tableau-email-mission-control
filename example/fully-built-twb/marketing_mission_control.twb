          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='Won - SP' datatype='real' name='[SAO - SP (copy)_1469696710713355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN &#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Alpha Two Letter' datatype='string' name='[alpha_two_letter]' role='dimension' type='nominal' />
            <column caption='Avg ARR per Won - SP' datatype='real' default-format='&quot;$&quot;#,##0' name='[cf_avg_arr_per_won]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_won_arr_sp]) / ZN(SUM([SAO - SP (copy)_1469696710713355]))' />
            </column>
            <column caption='Comparison Period - End Date' datatype='datetime' name='[cf_comparison_enddate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_enddate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_enddate]&#10;END' />
            </column>
            <column caption='Comparison Period - Start Date' datatype='datetime' name='[cf_comparison_startdate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[param_startdate], [Parameters].[param_enddate]) + 1), [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_startdate]&#10;END' />
            </column>
            <column caption='Won ARR - SP' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_won_arr_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won ARR - SP - No Region' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_won_arr_sp_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won ARR - SPLY - No Region' datatype='real' name='[cf_won_arr_sply_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won ARR - YoY % - No Region' datatype='real' default-format='p0.00%' name='[cf_won_arr_yoy_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_won_arr_sp_noregion]) - SUM([cf_won_arr_sply_noregion])) / ZN(SUM([cf_won_arr_sply_noregion]))' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Country (Rpt Marketing Bofu Opportunities)' datatype='string' name='[country (rpt_marketing_bofu_opportunities)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
