          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='ARR per Spend - SPLY' datatype='real' default-format='&quot;$&quot;#,##0' name='[ARR per Spend - SP (copy)_0401661403557894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_won_arr_sply]) / ZN(SUM([cf_spend_sply]))' />
            </column>
            <column caption='ARR per Spend - YoY %' datatype='real' default-format='p0.00%' name='[ARR per Spend - SPLY (copy)_0401661403668487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Avg ARR per Won - SP (copy)_0401661403336709] - [ARR per Spend - SP (copy)_0401661403557894]) / [ARR per Spend - SP (copy)_0401661403557894]' />
            </column>
            <column caption='Avg ARR per Won - SPLY' datatype='real' default-format='&quot;$&quot;#,##0' name='[Avg ARR per Won - SP (copy)_0401661402542083]' role='measure' type='quantitative'>
