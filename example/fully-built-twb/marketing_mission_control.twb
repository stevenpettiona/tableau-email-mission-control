          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='ATTR5 - Metric - Custom Model SP' datatype='real' name='[cf_attr5_metric_cust_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10;  IF [Parameters].[param_attr5_metric] = &quot;SAOs&quot; THEN [sao_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;Won&quot; THEN [won_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;ARR&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  END&#10;END' />
            </column>
            <column caption='ATTR5 - Metric - First Touch SP' datatype='real' name='[cf_attr5_metric_ft_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10;  IF [Parameters].[param_attr5_metric] = &quot;SAOs&quot; THEN [sao_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;Won&quot; THEN [won_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;ARR&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  END&#10;END' />
            </column>
            <column caption='ATTR5 - Metric - Lead Creation SP' datatype='real' name='[cf_attr5_metric_lc_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10;  IF [Parameters].[param_attr5_metric] = &quot;SAOs&quot; THEN [sao_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;Won&quot; THEN [won_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;ARR&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  END&#10;END' />
            </column>
            <column caption='ATTR5 - Metric - U-Shaped SP' datatype='real' name='[cf_attr5_metric_us_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_bofu_opportunities)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN&#10;  IF [Parameters].[param_attr5_metric] = &quot;SAOs&quot; THEN [sao_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;Won&quot; THEN [won_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attr5_metric] = &quot;ARR&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  END&#10;END' />
