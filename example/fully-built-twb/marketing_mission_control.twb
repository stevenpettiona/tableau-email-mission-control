              <calculation class='tableau' formula='SUM([cf_won_arr_sp]) / ZN(SUM([cf_spend_sp]))' />
            </column>
            <column caption='Avg ARR per Won - YoY %' datatype='real' default-format='p0.00%' name='[Avg ARR per Won - SP LY (copy)_0401661402619908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([cf_avg_arr_per_won] - [Avg ARR per Won - SP (copy)_0401661402542083]) / ZN([Avg ARR per Won - SP (copy)_0401661402542083])' />
            </column>
            <column caption='Cost per MQL - SP' datatype='real' default-format='C3081%' name='[Calculation_1469696697065472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cf_spend_sp])/ZN(sum([cf_mql_sp]))' />
            </column>
            <column caption='Cost per MQL - YoY %' datatype='real' default-format='p0.00%' name='[Cost per MQL - MoM % (copy)_0821193527746560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1469696697065472] - [Cost per MQL - SP (copy)_0821193528934401]) / ZN([Cost per MQL - SP (copy)_0821193528934401])' />
            </column>
            <column caption='Cost per MQL - SPLY' datatype='real' default-format='&quot;$&quot;#,##0' name='[Cost per MQL - SP (copy)_0821193528934401]' role='measure' type='quantitative'>
