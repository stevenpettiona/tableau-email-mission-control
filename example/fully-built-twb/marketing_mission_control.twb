            <column caption='Cost per Won - PM' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_won_pm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_pm]) / ZN(SUM([cf_won_pm]))' />
            </column>
            <column caption='Cost per Won - SP' datatype='real' default-format='c&quot;$&quot;#,##0' name='[cf_cost_per_won_sp]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cf_spend_sp]) / ZN(SUM([SAO - SP (copy)_1469696710713355]))' />
