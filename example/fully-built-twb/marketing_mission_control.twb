            <column caption='Formfills - SP - No Segment' datatype='integer' name='[Formfills - SP (copy)_1469696707022855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN [formfills] END' />
            </column>
            <column caption='MQL - SP - No Segment' datatype='integer' name='[MQL  - SP (copy)_1469696705163266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country (rpt_marketing_mofu_leads)] = [Parameters].[param_region])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;THEN &#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='MQL - per Formfills - No Segment' datatype='real' default-format='p0.00%' name='[MQL - per Formfills (copy)_1469696706379782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([MQL  - SP (copy)_1469696705163266])/ZN(sum([Formfills - SP (copy)_1469696707022855]))' />
            </column>
            <column caption='Alpha Two Letter' datatype='string' name='[alpha_two_letter]' role='dimension' type='nominal' />
            <column caption='Comparison Period - End Date' datatype='datetime' name='[cf_comparison_enddate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_enddate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_enddate]&#10;END' />
            </column>
            <column caption='Comparison Period - Start Date' datatype='datetime' name='[cf_comparison_startdate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[param_startdate], [Parameters].[param_enddate]) + 1), [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_startdate]&#10;END' />
            </column>
            <column caption='MQL - SP - No Region' datatype='integer' name='[cf_mql_sp_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_mofu_leads)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo] = [Parameters].[param_mqltsubype])&#10;THEN &#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='MQL - SP - No Region - No Segment' datatype='integer' name='[cf_mql_sp_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;THEN &#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='MQL - SPLY - No Region - No Segment' datatype='integer' name='[cf_mql_sply_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_direction] = &quot;All&quot; or [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; or [requested_demo] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;THEN &#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='MQL - YoY % - No Region - No Segment' datatype='real' default-format='p0.00%' name='[cf_mql_yoy_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_mql_sp_noregion]) - SUM([cf_mql_sply_noseg_noregion])) / ZN(SUM([cf_mql_sply_noseg_noregion]))' />
            </column>
