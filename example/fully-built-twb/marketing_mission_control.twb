              <calculation class='tableau' formula='#2026-03-31#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='MQL Sub-type' datatype='string' name='[param_mqltsubype]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='No Demo' />
                <alias key='&quot;1&quot;' value='Demo' />
              </aliases>
            </column>
            <column alias='Period over Period' caption='Period Comparison' datatype='string' name='[param_periodcomparison]' param-domain-type='list' role='measure' type='nominal' value='&quot;PoP&quot;'>
              <calculation class='tableau' formula='&quot;PoP&quot;' />
              <aliases>
                <alias key='&quot;Custom&quot;' value='Custom Range' />
                <alias key='&quot;PoP&quot;' value='Period over Period' />
                <alias key='&quot;YoY&quot;' value='Year over Year' />
              </aliases>
            </column>
            <column caption='Comparison End Date' datatype='date' name='[param_periodcomparison_enddate]' param-domain-type='range' role='measure' type='quantitative' value='#2025-04-29#'>
              <calculation class='tableau' formula='#2025-04-29#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='Comparison Start Date' datatype='date' name='[param_periodcomparison_startdate]' param-domain-type='range' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='Start Date' datatype='date' name='[param_startdate]' param-domain-type='range' role='measure' type='quantitative' value='#2026-03-01#'>
              <calculation class='tableau' formula='#2026-03-01#' />
              <range min='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='Alpha Two Letter' datatype='string' name='[alpha_two_letter]' role='dimension' type='nominal' />
            <column caption='Comparison Period - End Date' datatype='datetime' name='[cf_comparison_enddate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_enddate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_enddate]&#10;END' />
            </column>
            <column caption='Comparison Period - Start Date' datatype='datetime' name='[cf_comparison_startdate]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[param_periodcomparison] = &quot;YoY&quot; THEN DATEADD(&apos;year&apos;, -1, [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;PoP&quot; THEN DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;, [Parameters].[param_startdate], [Parameters].[param_enddate]) + 1), [Parameters].[param_startdate])&#10;ELSEIF [Parameters].[param_periodcomparison] = &quot;Custom&quot; THEN [Parameters].[param_periodcomparison_startdate]&#10;END' />
            </column>
            <column caption='Won ARR - SP - No Region - No Segment' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_won_arr_sp_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [Parameters].[param_startdate] AND [report_date] &lt;= [Parameters].[param_enddate])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won ARR - SPLY - No Region - No Segment' datatype='real' name='[cf_won_arr_sply_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won ARR - YoY % - No Region - No Segment' datatype='real' default-format='p0.00%' name='[cf_won_arr_yoy_noseg_noregion]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_won_arr_sp_noseg_noregion]) - SUM([cf_won_arr_sply_noseg_noregion])) / ZN(SUM([cf_won_arr_sply_noseg_noregion]))' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
            <column datatype='string' name='[employee_segment (Custom SQL Query)]' role='dimension' type='nominal' />
