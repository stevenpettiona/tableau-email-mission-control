          <datasource-dependencies datasource='federated.0h0rhj21s8fugq1ekg8b50nmig8c'>
            <column caption='FF1 - Bofu - Chart Date Filter' datatype='string' name='[ROI4 - Bofu - Chart Date Filter (copy)_5230166126829568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[param_roi4_granularity] = &quot;day&quot; AND DATEDIFF(&apos;day&apos;, DATEADD(&apos;day&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0) AND [report_date] &lt; [Parameters].[param_enddate]&#10;OR ([Parameters].[param_roi4_granularity] = &quot;week&quot; AND DATEDIFF(&apos;week&apos;, DATEADD(&apos;week&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0) AND [report_date] &lt; [Parameters].[param_enddate]&#10;OR ([Parameters].[param_roi4_granularity] = &quot;month&quot; AND DATEDIFF(&apos;month&apos;, DATEADD(&apos;month&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;THEN &quot;true&quot; ELSE &quot;false&quot; END' />
            </column>
            <column caption='ROI4 - Chart Date Label' datatype='string' name='[ROI4 - Chart Date (copy)_3302308891381765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[param_roi4_granularity]&#10;   WHEN &apos;month&apos; THEN STR(YEAR([report_date]))+&quot;/&quot;+STR(MONTH([report_date]))&#10;   WHEN &apos;week&apos; THEN STR(YEAR([report_date]))+&quot; WK&quot;+LEFT(DATENAME(&apos;week&apos;, [report_date]), 2)&#10;   WHEN &apos;day&apos; THEN STR(YEAR([report_date]))+&quot;/&quot;+STR(MONTH([report_date]))+&quot;/&quot;+STR(DAY([report_date]))&#10;END' />
            </column>
            <column caption='FF1 - Mofu - Chart Date Filter' datatype='string' name='[ROI4 - Mofu - Chart Date Filter (copy)_5230166126952449]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[param_roi4_granularity] = &quot;day&quot; AND DATEDIFF(&apos;day&apos;, DATEADD(&apos;day&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;OR ([Parameters].[param_roi4_granularity] = &quot;week&quot; AND DATEDIFF(&apos;week&apos;, DATEADD(&apos;week&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;OR ([Parameters].[param_roi4_granularity] = &quot;month&quot; AND DATEDIFF(&apos;month&apos;, DATEADD(&apos;month&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;THEN &quot;true&quot; ELSE &quot;false&quot; END' />
            </column>
            <column caption='FF1 - Tofu - Chart Date Filter' datatype='string' name='[ROI4 - Tofu - Chart Date Filter (copy)_5230166127022082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[param_roi4_granularity] = &quot;day&quot; AND DATEDIFF(&apos;day&apos;, DATEADD(&apos;day&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;OR ([Parameters].[param_roi4_granularity] = &quot;week&quot; AND DATEDIFF(&apos;week&apos;, DATEADD(&apos;week&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;OR ([Parameters].[param_roi4_granularity] = &quot;month&quot; AND DATEDIFF(&apos;month&apos;, DATEADD(&apos;month&apos;, -8, [Parameters].[param_enddate]), [report_date]) &gt;= 0)  AND [report_date] &lt; [Parameters].[param_enddate]&#10;THEN &quot;true&quot; ELSE &quot;false&quot; END' />
            </column>
            <column caption='Alpha Two Letter' datatype='string' name='[alpha_two_letter]' role='dimension' type='nominal' />
            <column caption='Formfills - No Date' datatype='integer' name='[cf_formfills_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [Parameters].[param_channel] = [channel_group])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [Parameters].[param_direction] = [direction])&#10;THEN [formfills] END' />
            </column>
            <column caption='MQL - No Date' datatype='integer' name='[cf_mql_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_mofu_leads)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo] = [Parameters].[param_mqltsubype])&#10;THEN&#10; IF [Parameters].[param_mqltype] = &quot;All&quot; THEN [mql_count] + [recycled_mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;New&quot; THEN [mql_count]&#10;  ELSEIF [Parameters].[param_mqltype] = &quot;Recycled&quot; THEN [recycled_mql_count]&#10;  END&#10;END' />
            </column>
            <column caption='SAO - No Date' datatype='real' name='[cf_sao_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [sao_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [sao_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [sao_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [sao_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [sao_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Sessions - No Date' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[cf_sessions_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [sessions] END' />
            </column>
            <column caption='Spend - No Date' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_spend_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;THEN [spend] END' />
            </column>
            <column caption='Won ARR - No Date' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[cf_won_arr_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_arr_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_arr_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_arr_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_arr_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_arr_weighted_with_unattributed_ws]&#10;  END&#10;END' />
            </column>
            <column caption='Won - No Date' datatype='real' name='[cf_won_no_date]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment (rpt_marketing_bofu_opportunities)] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot; OR [channel_group] = [Parameters].[param_channel])&#10;AND ([Parameters].[param_direction] = &quot;All&quot; OR [direction] = [Parameters].[param_direction])&#10;AND ([Parameters].[param_mqltsubype] = &quot;All&quot; OR [requested_demo (rpt_marketing_bofu_opportunities)] = [Parameters].[param_mqltsubype])&#10;THEN&#10; IF [Parameters].[param_attributionmodel] = &quot;Custom Model&quot; THEN [won_weighted_with_unattributed_cust]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;First Touch&quot; THEN [won_weighted_with_unattributed_ft]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;Lead Creation&quot; THEN [won_weighted_with_unattributed_lc]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;U-Shaped&quot; THEN [won_weighted_with_unattributed_us]&#10;  ELSEIF [Parameters].[param_attributionmodel] = &quot;W-Shaped&quot; THEN [won_weighted_with_unattributed_ws]&#10;  END&#10;END' />
