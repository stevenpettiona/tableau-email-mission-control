                </zone>
                <zone fixed-size='38' forceUpdate='true' h='4600' id='1187' type-v2='text' w='19072' x='928' y='19300'>
                  <formatted-text>
                    <run fontcolor='#555555' fontname='Tableau Light' fontsize='7'>100% credit to the very first interaction. Best for measuring top-of-funnel awareness and initial channel discovery.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='54' forceUpdate='true' h='4600' id='1198' type-v2='text' w='19072' x='20714' y='19300'>
                  <formatted-text>
                    <run fontcolor='#555555' fontname='Tableau Light' fontsize='7'>100% credit to the touchpoint that created the lead. Highlights which channels drive net-new lead generation.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4700' id='1211' type-v2='text' w='19072' x='40500' y='19300'>
                  <formatted-text>
                    <run fontcolor='#555555' fontname='Tableau Light' fontsize='7'>Heavy weight on First Touch and Lead Creation (40% each), with remaining 20% spread across intermediate touchpoints.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4700' id='1223' type-v2='text' w='19071' x='60286' y='19300'>
                  <formatted-text>
                    <run fontcolor='#555555' fontname='Tableau Light' fontsize='7'>30% each to First Touch, Lead Creation, and Opportunity Creation. Remaining 10% distributed across in-between touchpoints.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4700' id='1237' type-v2='text' w='19001' x='80071' y='19300'>
                  <formatted-text>
                    <run fontcolor='#555555' fontname='Tableau Light' fontsize='7'>Maps up to 6 custom milestone stages to reflect unique business journeys. Flexible allocation across any key touchpoints.</run>
