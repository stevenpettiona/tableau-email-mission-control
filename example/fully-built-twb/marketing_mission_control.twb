              <calculation class='tableau' formula='IF ([Parameters].[param_region] = &quot;Global&quot; OR [country] = [Parameters].[param_region])&#10;AND ([Parameters].[param_segment] = &quot;All&quot; OR [employee_segment] = [Parameters].[param_segment])&#10;AND ([Parameters].[param_channel] = &quot;All&quot;)&#10;AND ([Parameters].[param_direction] = &quot;All&quot;)&#10;AND ([report_date] &gt;= [cf_comparison_startdate] AND [report_date] &lt;= [cf_comparison_enddate])&#10;THEN [formfills] END' />
            </column>
            <column caption='Formfills - YoY %' datatype='real' default-format='p0.00%' name='[cf_formfills_yoy]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cf_formfills_sp]) - SUM([cf_formfills_sply])) / ZN(SUM([cf_formfills_sply]))' />
            </column>
            <column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
            <column caption='Employee Segment' datatype='string' name='[employee_segment]' role='dimension' type='nominal' />
            <column caption='Formfills' datatype='integer' name='[formfills]' role='measure' type='quantitative' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[cf_formfills_sp]' derivation='Sum' name='[sum:cf_formfills_sp:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cf_formfills_yoy]' derivation='User' name='[usr:cf_formfills_yoy:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
