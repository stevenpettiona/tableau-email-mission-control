          <calculation class='tableau' formula='CASE [Parameters].[Volume Metric] WHEN &quot;Sends&quot; THEN [Sends SP] WHEN &quot;Opens&quot; THEN [Opens SP] WHEN &quot;Clicks&quot; THEN [Clicks SP] WHEN &quot;Unsubscribes&quot; THEN [Unsubscribes SP] END' />
