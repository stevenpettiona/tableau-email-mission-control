          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
            <format attr='mark-labels-cull' value='true' />
            <format attr='mark-color' value='#7a48b9' />
          </style-rule>
        </style>
      </pane>
    </panes>
    <rows>[federated.ehemailpipeline].[usr:Pipeline - Dynamic SP:qk]</rows>
    <cols>[federated.ehemailpipeline].[none:event_week:ok]</cols>
  </table>
