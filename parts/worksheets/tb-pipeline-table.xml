<worksheet name='[TB] Pipeline Table'>
  <layout-options>
    <title>
      <formatted-text>
        <run bold='true' fontalignment='1' fontcolor='#6b3fa0' fontname='Poppins' fontsize='8'>PIPELINE TABLE</run>
      </formatted-text>
    </title>
  </layout-options>
  <table>
    <view>
      <datasources>
        <datasource caption='EH Email Pipeline' name='federated.ehemailpipeline' />
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='End Date' datatype='date' name='[End Date]' param-domain-type='range' role='measure' type='quantitative' value='#2026-05-01#'>
          <calculation class='tableau' formula='#2026-05-01#' />
          <range min='#2023-01-01#' />
        </column>
        <column caption='Start Date' datatype='date' name='[Start Date]' param-domain-type='range' role='measure' type='quantitative' value='#2026-05-01#'>
          <calculation class='tableau' formula='#2026-05-01#' />
          <range min='#2023-01-01#' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.ehemailpipeline'>
        <column caption='Won ARR SP' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Won ARR SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= [Parameters].[Start Date] AND [sao_date] &lt;= [Parameters].[End Date] THEN [won_arr_weighted_cust] END)' />
        </column>
        <column caption='Wons SP' datatype='integer' name='[Wons SP]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [sao_date] &gt;= [Parameters].[Start Date] AND [sao_date] &lt;= [Parameters].[End Date] THEN [wons_weighted_cust] END)' />
        </column>
        <column caption='Program Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
        <column caption='Leads' datatype='integer' name='[leads]' role='measure' type='quantitative' />
        <column caption='MQLs' datatype='integer' name='[mqls]' role='measure' type='quantitative' />
        <column caption='SAO Date' datatype='date' name='[sao_date]' role='dimension' type='ordinal' />
        <column caption='SAOs' datatype='integer' name='[saos]' role='measure' type='quantitative' />
        <column-instance column='[leads]' derivation='Sum' name='[sum:leads:qk]' pivot='key' type='quantitative' />
        <column-instance column='[mqls]' derivation='Sum' name='[sum:mqls:qk]' pivot='key' type='quantitative' />
        <column-instance column='[saos]' derivation='Sum' name='[sum:saos:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Won ARR SP]' derivation='User' name='[usr:Won ARR SP:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Wons SP]' derivation='User' name='[usr:Wons SP:qk]' pivot='key' type='quantitative' />
        <column caption='Won ARR (Weighted Custom)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[won_arr_weighted_cust]' role='measure' type='quantitative' />
        <column caption='Wons (Weighted Custom)' datatype='integer' name='[wons_weighted_cust]' role='measure' type='quantitative' />
      </datasource-dependencies>
      <filter class='categorical' column='[federated.ehemailpipeline].[:Measure Names]'>
        <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailpipeline].[sum:leads:qk]&quot;' />
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailpipeline].[sum:mqls:qk]&quot;' />
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailpipeline].[sum:saos:qk]&quot;' />
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailpipeline].[usr:Won ARR SP:qk]&quot;' />
          <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.ehemailpipeline].[usr:Wons SP:qk]&quot;' />
        </groupfilter>
      </filter>
      <manual-sort column='[federated.ehemailpipeline].[:Measure Names]' direction='ASC'>
        <dictionary>
          <bucket>&quot;[federated.ehemailpipeline].[sum:leads:qk]&quot;</bucket>
          <bucket>&quot;[federated.ehemailpipeline].[sum:mqls:qk]&quot;</bucket>
          <bucket>&quot;[federated.ehemailpipeline].[sum:saos:qk]&quot;</bucket>
          <bucket>&quot;[federated.ehemailpipeline].[usr:Wons SP:qk]&quot;</bucket>
          <bucket>&quot;[federated.ehemailpipeline].[usr:Won ARR SP:qk]&quot;</bucket>
        </dictionary>
      </manual-sort>
      <filter class='categorical' column='[federated.ehemailpipeline].[campaign_name]'>
        <groupfilter function='level-members' level='[campaign_name]' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-manual-selection-is-empty='true' user:ui-marker='enumerate' />
      </filter>
      <shelf-sorts>
        <shelf-sort-v2 dimension-to-sort='[federated.ehemailpipeline].[campaign_name]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.ehemailpipeline].[sum:saos:qk]' shelf='rows' />
      </shelf-sorts>
      <slices>
        <column>[federated.ehemailpipeline].[:Measure Names]</column>
        <column>[federated.ehemailpipeline].[campaign_name]</column>
      </slices>
      <aggregation value='true' />
    </view>
